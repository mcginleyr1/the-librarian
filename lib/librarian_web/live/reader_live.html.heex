<Layouts.reader flash={@flash}>
  <div class="flex flex-1 overflow-hidden h-full min-h-0">
    <%!-- LEFT SIDEBAR --%>
    <aside class="w-72 shrink-0 bg-base-200 flex flex-col overflow-hidden border-r border-base-300 min-h-0">
      <div class="p-3 border-b border-base-300 bg-gradient-to-r from-primary/10 to-transparent space-y-2">
        <div class="flex items-center gap-2.5">
          <div class="size-8 rounded-lg bg-primary/15 text-primary grid place-items-center shrink-0">
            <.icon name="hero-book-open" class="size-4" />
          </div>
          <span class="font-bold text-sm flex-1">The Librarian</span>
        </div>
        <Layouts.nav_pills active={:reader} compact />
      </div>
      <div class="px-2 pt-2">
        <.link
          patch="/reader"
          class={[
            "flex items-center gap-2 px-2.5 py-2 rounded-lg text-sm transition",
            if(is_nil(@selected_feed_id) and is_nil(@selected_category),
              do: "bg-primary text-primary-content font-medium shadow-sm",
              else: "hover:bg-base-300"
            )
          ]}
        >
          <.icon name="hero-inbox" class="size-4 shrink-0" />
          <span class="flex-1">All Unread</span>
          <span class="rounded-full bg-base-content/10 px-2 py-0.5 text-xs tabular-nums">
            {Enum.sum(Map.values(@unread_counts))}
          </span>
        </.link>
      </div>
      <div class="flex-1 min-h-0 overflow-y-auto px-2 py-2 space-y-3">
        <%= for {category, feeds} <- @feeds_by_category do %>
          <% category_key = category || "uncategorized" %>
          <% collapsed = MapSet.member?(@collapsed_categories, category_key) %>
          <% category_count =
            Enum.reduce(feeds, 0, fn feed, acc -> acc + Map.get(@unread_counts, feed.id, 0) end) %>
          <div>
            <div class="flex items-center gap-1 px-2 mb-1 group">
              <.link
                patch={"/reader/category/#{URI.encode(category_key, &URI.char_unreserved?/1)}"}
                class={[
                  "flex-1 text-xs font-semibold uppercase tracking-wider transition-colors truncate",
                  if(@selected_category == category_key,
                    do: "text-primary",
                    else: "text-base-content/40 hover:text-base-content/70"
                  )
                ]}
              >
                {category || "Uncategorized"}
              </.link>
              <span :if={category_count > 0} class="text-xs text-base-content/30 shrink-0">
                {category_count}
              </span>
              <button
                phx-click="toggle_category"
                phx-value-category={category_key}
                class="press opacity-0 group-hover:opacity-100 transition-opacity p-0.5 rounded hover:bg-base-300 shrink-0"
                title={if collapsed, do: "Expand", else: "Collapse"}
              >
                <.icon
                  name={if collapsed, do: "hero-chevron-right", else: "hero-chevron-down"}
                  class="size-3 text-base-content/40"
                />
              </button>
            </div>
            <div :if={!collapsed} class="space-y-0.5">
              <.link
                :for={feed <- feeds}
                patch={"/reader/feed/#{feed.id}"}
                class={[
                  "flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-sm transition",
                  if(@selected_feed_id == feed.id,
                    do: "bg-primary text-primary-content font-medium shadow-sm",
                    else: "hover:bg-base-300"
                  )
                ]}
              >
                <span class="flex-1 truncate">{feed.title}</span>
                <span
                  :if={Map.get(@unread_counts, feed.id, 0) > 0}
                  class="rounded-full bg-base-content/10 px-1.5 py-0.5 text-[10px] tabular-nums shrink-0"
                >
                  {Map.get(@unread_counts, feed.id)}
                </span>
              </.link>
            </div>
          </div>
        <% end %>
      </div>
      <div class="p-2 border-t border-base-300 flex gap-1">
        <a href="/dashboard" class="press btn btn-ghost btn-xs flex-1 gap-1">
          <.icon name="hero-chart-bar" class="size-3" /> Stats
        </a>
        <a href="/vault" class="press btn btn-ghost btn-xs flex-1 gap-1">
          <.icon name="hero-archive-box" class="size-3" /> Vault
        </a>
        <a href="/settings" class="press btn btn-ghost btn-xs flex-1 gap-1">
          <.icon name="hero-cog-6-tooth" class="size-3" /> Settings
        </a>
      </div>
    </aside>

    <%!-- MIDDLE: Article List --%>
    <div class="w-80 shrink-0 flex flex-col border-r border-base-300 bg-base-100 overflow-hidden min-h-0">
      <div class="px-3 py-2.5 border-b border-base-300 flex items-center gap-2">
        <div class="inline-flex rounded-full bg-base-200 p-0.5">
          <button
            :for={
              {label, value} <- [{"Unread", "unread"}, {"All", "all"}, {"Starred", "starred"}]
            }
            phx-click="set_filter"
            phx-value-filter={value}
            class={[
              "press rounded-full px-3 py-1 text-xs transition",
              if(to_string(@filter) == value,
                do: "bg-base-100 shadow-sm font-semibold",
                else: "text-base-content/60 hover:text-base-content"
              )
            ]}
          >
            {label}
          </button>
        </div>
        <button
          phx-click="mark_all_read"
          class="press btn btn-ghost btn-xs ml-auto"
          title="Mark all read"
        >
          <.icon name="hero-check-circle" class="size-4" />
        </button>
      </div>
      <div :if={@pending_new > 0} class="px-1.5 pt-1.5">
        <button
          id="new-articles-pill"
          phx-click="show_new_articles"
          class="press w-full flex items-center justify-center gap-1.5 rounded-full bg-primary/10 text-primary hover:bg-primary/20 px-3 py-1.5 text-xs font-semibold transition prism-in"
        >
          <.icon name="hero-arrow-up" class="size-3" />
          {@pending_new} new {if @pending_new == 1, do: "article", else: "articles"}
        </button>
      </div>
      <div
        id="article-list"
        class="flex-1 min-h-0 overflow-y-auto p-1.5 space-y-0.5"
        phx-update="stream"
        phx-viewport-bottom={@more_articles? && "load_more"}
      >
        <div
          :for={{dom_id, article} <- @streams.articles}
          id={dom_id}
          phx-click="select_article"
          phx-value-id={article.id}
          class={[
            "press cursor-pointer px-2.5 py-2 rounded-lg transition-colors",
            if(@selected_article && @selected_article.id == article.id,
              do: "bg-primary/10 ring-1 ring-primary/20",
              else: "hover:bg-base-200"
            )
          ]}
        >
          <div class="flex items-start gap-1.5">
            <div class="flex-1 min-w-0">
              <p class={[
                "text-sm leading-snug line-clamp-2",
                if(article.read_state && article.read_state.read_at,
                  do: "text-base-content/50",
                  else: "font-medium text-base-content"
                )
              ]}>
                {article.title || article.url || "(no title)"}
              </p>
              <p class="text-xs text-base-content/40 mt-0.5 truncate">
                {article.feed && article.feed.title}
                <span :if={article.published_at}>
                  · {Calendar.strftime(article.published_at, "%b %d")}
                </span>
              </p>
            </div>
            <.icon
              :if={article.read_state && article.read_state.starred}
              name="hero-star-solid"
              class="size-3 shrink-0 text-warning mt-0.5"
            />
          </div>
        </div>
      </div>
    </div>

    <%!-- RIGHT: Article Content --%>
    <main
      id="article-reader"
      class="flex-1 min-h-0 overflow-y-auto bg-base-100"
      phx-hook=".KeyNav"
    >
      <script :type={Phoenix.LiveView.ColocatedHook} name=".KeyNav">
        export default {
          mounted() {
            this._keyHandler = (e) => {
              if (["j","k","r","s","o"].includes(e.key) &&
                  !e.target.matches("input,textarea,select,[contenteditable]")) {
                e.preventDefault()
                this.pushEvent("key_nav", {key: e.key})
              }
            }
            window.addEventListener("keydown", this._keyHandler)
            this.handleEvent("open_url", ({url}) => {
              if (url) window.open(url, "_blank", "noopener,noreferrer")
            })
          },
          destroyed() {
            window.removeEventListener("keydown", this._keyHandler)
          }
        }
      </script>

      <div
        :if={is_nil(@selected_article)}
        class="flex items-center justify-center h-full text-base-content/30"
      >
        <div class="text-center select-none">
          <div class="size-16 mx-auto rounded-2xl bg-base-200 text-base-content/30 grid place-items-center mb-4">
            <.icon name="hero-newspaper" class="size-8" />
          </div>
          <p class="text-lg font-medium">Select an article to read</p>
          <p class="text-sm mt-2 opacity-60">j/k navigate · s star · o open original</p>
        </div>
      </div>

      <div :if={@selected_article} class="max-w-[680px] mx-auto px-8 py-10 prism-in">
        <div class="text-sm text-base-content/50 mb-3 flex items-center gap-2 flex-wrap">
          <span class="font-medium text-base-content/70">
            {@selected_article.feed && @selected_article.feed.title}
          </span>
          <span :if={@selected_article.author}>by {@selected_article.author}</span>
          <span :if={@selected_article.published_at}>
            · {Calendar.strftime(@selected_article.published_at, "%B %-d, %Y")}
          </span>
        </div>
        <h1 class="text-2xl font-bold leading-tight mb-5 text-base-content">
          {@selected_article.title}
        </h1>
        <div class="flex items-center gap-1 mb-8 pb-5 border-b border-base-200">
          <a
            href={@selected_article.url}
            target="_blank"
            rel="noopener noreferrer"
            class="press btn btn-sm btn-ghost gap-1.5"
          >
            <.icon name="hero-arrow-top-right-on-square" class="size-4" /> Open original
          </a>
          <button
            phx-click="toggle_star"
            phx-value-id={@selected_article.id}
            class={[
              "press btn btn-sm btn-ghost gap-1.5 hover:text-warning",
              @selected_article.read_state && @selected_article.read_state.starred &&
                "text-warning"
            ]}
          >
            <.icon
              name={
                if @selected_article.read_state && @selected_article.read_state.starred,
                  do: "hero-star-solid",
                  else: "hero-star"
              }
              class="size-4"
            />
            {if @selected_article.read_state && @selected_article.read_state.starred,
              do: "Starred",
              else: "Star"}
          </button>
          <div class="ml-auto flex items-center gap-1">
            <button
              id="feedback-like"
              phx-click="feedback"
              phx-value-id={@selected_article.id}
              phx-value-kind="like"
              class="press btn btn-sm btn-ghost gap-1.5 hover:bg-success/10 hover:text-success"
              title="More like this"
            >
              <.icon name="hero-hand-thumb-up" class="size-4" /> Like
            </button>
            <button
              id="feedback-dislike"
              phx-click="feedback"
              phx-value-id={@selected_article.id}
              phx-value-kind="dislike"
              class="press btn btn-sm btn-ghost gap-1.5 hover:bg-error/10 hover:text-error"
              title="Less like this"
            >
              <.icon name="hero-hand-thumb-down" class="size-4" /> Dislike
            </button>
          </div>
        </div>
        <div class="article-body text-base leading-relaxed">
          {Phoenix.HTML.raw(
            @selected_article.content || @selected_article.summary ||
              "<p class='text-base-content/50 italic'>No content available. Open original to read.</p>"
          )}
        </div>
      </div>
    </main>
  </div>
</Layouts.reader>
