<% pane = mobile_pane(assigns) %>
<Layouts.vault flash={@flash}>
  <div
    id="vault-root"
    class="flex flex-1 overflow-hidden h-full min-h-0"
    phx-hook=".VaultShortcuts"
  >
    <script :type={Phoenix.LiveView.ColocatedHook} name=".VaultShortcuts">
      export default {
        mounted() {
          this._keydown = (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
              e.preventDefault()
              this.pushEvent("open_switcher", {})
            }
          }
          window.addEventListener("keydown", this._keydown)
        },
        destroyed() {
          window.removeEventListener("keydown", this._keydown)
        }
      }
    </script>
    <%!-- SIDEBAR: Notebooks --%>
    <aside class={[
      "w-72 shrink-0 bg-base-200 flex flex-col overflow-hidden border-r border-base-300 min-h-0",
      "max-md:w-full max-md:border-r-0",
      pane != :notebooks && "max-md:hidden"
    ]}>
      <div class="p-3 border-b border-base-300 bg-gradient-to-r from-primary/10 to-transparent space-y-2">
        <div class="flex items-center gap-2.5">
          <div class="size-8 rounded-lg bg-primary/15 text-primary grid place-items-center shrink-0">
            <.icon name="hero-archive-box" class="size-4" />
          </div>
          <span class="font-bold text-sm flex-1">Vault</span>
          <button
            phx-click="toggle_notebooks"
            class="press md:hidden btn btn-ghost btn-xs btn-square"
            aria-label="Close notebook list"
          >
            <.icon name="hero-x-mark" class="size-4" />
          </button>
        </div>
        <Layouts.nav_pills active={:vault} compact />
      </div>
      <div class="flex-1 min-h-0 overflow-y-auto p-2 space-y-0.5">
        <.link
          patch="/vault"
          class={[
            "flex items-center justify-between px-2.5 py-2 rounded-lg text-sm transition",
            if(is_nil(@selected_notebook_id),
              do: "bg-primary text-primary-content font-medium shadow-sm",
              else: "hover:bg-base-300"
            )
          ]}
        >
          <span class="flex items-center gap-2">
            <.icon name="hero-archive-box" class="size-4 shrink-0" /> All Notes
          </span>
          <span class="rounded-full bg-base-content/10 px-2 py-0.5 text-xs tabular-nums">
            {Enum.sum(Map.values(@note_counts))}
          </span>
        </.link>
        <.link
          :for={notebook <- @notebooks}
          patch={"/vault/notebook/#{notebook.id}"}
          class={[
            "flex items-center justify-between px-2.5 py-2 rounded-lg text-sm transition",
            if(@selected_notebook_id == notebook.id,
              do: "bg-primary text-primary-content font-medium shadow-sm",
              else: "hover:bg-base-300"
            )
          ]}
        >
          <span class="flex items-center gap-2 min-w-0">
            <.icon name="hero-book-open" class="size-4 shrink-0" />
            <span class="truncate">{notebook.name}</span>
          </span>
          <span class="rounded-full bg-base-content/10 px-2 py-0.5 text-xs tabular-nums shrink-0">
            {Map.get(@note_counts, notebook.id, 0)}
          </span>
        </.link>
      </div>
      <div class="p-2 border-t border-base-300 space-y-2">
        <form phx-submit="create_notebook" class="flex gap-1">
          <input
            name="name"
            type="text"
            placeholder="New notebook..."
            class="input input-bordered input-xs flex-1 min-w-0 rounded-lg"
          />
          <button type="submit" class="press btn btn-primary btn-xs rounded-lg">+</button>
        </form>
        <.link navigate="/vault/graph" class="press btn btn-ghost btn-xs w-full gap-1">
          <.icon name="hero-share" class="size-3" /> Graph
        </.link>
        <a href="/settings" class="press btn btn-ghost btn-xs w-full gap-1">
          <.icon name="hero-cog-6-tooth" class="size-3" /> Settings
        </a>
      </div>
    </aside>

    <%!-- MIDDLE: Note List --%>
    <div class={[
      "w-72 shrink-0 flex flex-col border-r border-base-300 bg-base-100 overflow-hidden min-h-0",
      "max-md:w-full max-md:border-r-0",
      pane != :list && "max-md:hidden"
    ]}>
      <div class="px-3 py-2.5 border-b border-base-300 flex gap-2 items-center">
        <button
          :if={!@selection_mode}
          phx-click="toggle_notebooks"
          class="press md:hidden btn btn-ghost btn-sm btn-square shrink-0"
          aria-label="Show notebooks"
        >
          <.icon name="hero-bars-3" class="size-5" />
        </button>
        <%= if @selection_mode do %>
          <button
            type="submit"
            form="bulk-form"
            class="press btn btn-error btn-xs flex-1 gap-1"
            data-confirm="Delete selected notes permanently?"
          >
            <.icon name="hero-trash" class="size-3" /> Delete Selected
          </button>
          <button
            type="button"
            phx-click="toggle_selection_mode"
            class="press btn btn-ghost btn-xs"
          >
            Cancel
          </button>
        <% else %>
          <form phx-change="search" class="flex-1 min-w-0 relative">
            <.icon
              name="hero-magnifying-glass"
              class="size-3.5 text-base-content/40 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none"
            />
            <input
              type="text"
              name="q"
              value={@search_query}
              placeholder="Search notes..."
              class="input input-bordered input-xs w-full rounded-full pl-7"
              phx-debounce="300"
            />
          </form>
          <button
            type="button"
            phx-click="toggle_selection_mode"
            class="press btn btn-ghost btn-xs"
            title="Select multiple"
          >
            <.icon name="hero-check-circle" class="size-3" />
          </button>
          <button
            type="button"
            phx-click="new_note"
            class="press btn btn-primary btn-xs"
            title="New note"
          >
            <.icon name="hero-plus" class="size-3" />
          </button>
        <% end %>
      </div>
      <form
        id="bulk-form"
        phx-submit="bulk_delete"
        class="flex-1 min-h-0 overflow-hidden flex flex-col"
      >
        <div
          id="notes-list"
          class="flex-1 min-h-0 overflow-y-auto p-1.5 space-y-0.5"
          phx-update="stream"
          phx-viewport-bottom={@more_notes? && "load_more"}
        >
          <div :for={{dom_id, note} <- @streams.notes} id={dom_id}>
            <%= if @selection_mode do %>
              <label class="flex items-start gap-2 cursor-pointer px-2.5 py-2 rounded-lg hover:bg-base-200 transition-colors">
                <input
                  type="checkbox"
                  name="ids[]"
                  value={note.id}
                  class="checkbox checkbox-sm mt-0.5 shrink-0"
                />
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium truncate">{note.title || "(Untitled)"}</p>
                  <p class="text-xs text-base-content/50 mt-0.5">
                    <span :if={note.notebook}>{note.notebook.name} ·</span>
                    {Calendar.strftime(note.inserted_at, "%b %-d, %Y")}
                  </p>
                  <div :if={note.tags != []} class="flex flex-wrap gap-1 mt-1">
                    <span
                      :for={tag <- Enum.take(note.tags, 3)}
                      class="rounded-full bg-base-content/10 px-1.5 py-0.5 text-[10px] text-base-content/60"
                    >
                      {tag.name}
                    </span>
                  </div>
                </div>
              </label>
            <% else %>
              <div
                phx-click="select_note"
                phx-value-id={note.id}
                class={[
                  "press cursor-pointer px-2.5 py-2 rounded-lg transition-colors",
                  if(@selected_note && @selected_note.id == note.id,
                    do: "bg-primary/10 ring-1 ring-primary/20",
                    else: "hover:bg-base-200"
                  )
                ]}
              >
                <p class="text-sm font-medium truncate">{note.title || "(Untitled)"}</p>
                <p class="text-xs text-base-content/50 mt-0.5">
                  <span :if={note.notebook}>{note.notebook.name} ·</span>
                  {Calendar.strftime(note.inserted_at, "%b %-d, %Y")}
                </p>
                <div :if={note.tags != []} class="flex flex-wrap gap-1 mt-1">
                  <span
                    :for={tag <- Enum.take(note.tags, 3)}
                    class="rounded-full bg-base-content/10 px-1.5 py-0.5 text-[10px] text-base-content/60"
                  >
                    {tag.name}
                  </span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </form>
    </div>

    <%!-- RIGHT: Note Viewer / Editor --%>
    <main class={[
      "flex-1 min-h-0 overflow-y-auto bg-base-100",
      pane != :note && "max-md:hidden"
    ]}>
      <div
        :if={@selected_note || @editing}
        class="md:hidden sticky top-0 z-10 bg-base-100/95 backdrop-blur border-b border-base-200 px-2 py-1.5"
      >
        <button phx-click="back_to_list" class="press btn btn-ghost btn-sm gap-1">
          <.icon name="hero-chevron-left" class="size-4" /> Notes
        </button>
      </div>

      <div
        :if={is_nil(@selected_note) && !@editing}
        class="flex items-center justify-center h-full text-base-content/30"
      >
        <div class="text-center select-none">
          <div class="size-16 mx-auto rounded-2xl bg-base-200 text-base-content/30 grid place-items-center mb-4">
            <.icon name="hero-document-text" class="size-8" />
          </div>
          <p class="text-lg font-medium">Select a note or create a new one</p>
        </div>
      </div>

      <%!-- Editor --%>
      <div :if={@editing} class="max-w-2xl mx-auto px-4 py-6 md:px-8 md:py-10 prism-in">
        <h2 class="text-xl font-bold mb-6">
          {if @selected_note, do: "Edit Note", else: "New Note"}
        </h2>
        <form id="note-form" phx-submit="save_note" phx-change="editor_change" class="space-y-4">
          <div>
            <label class="label"><span class="label-text font-medium">Title</span></label>
            <input
              type="text"
              name="note[title]"
              value={if @selected_note, do: @selected_note.title, else: ""}
              placeholder="Note title..."
              class="input input-bordered w-full rounded-lg"
            />
          </div>
          <div>
            <label class="label"><span class="label-text font-medium">Source URL</span></label>
            <input
              type="text"
              name="note[source_url]"
              value={if @selected_note, do: @selected_note.source_url, else: ""}
              placeholder="https://..."
              class="input input-bordered w-full rounded-lg"
            />
          </div>
          <div>
            <label class="label"><span class="label-text font-medium">Notebook</span></label>
            <select name="note[notebook_id]" class="select select-bordered w-full rounded-lg">
              <option value="">— no notebook —</option>
              <option
                :for={nb <- @notebooks}
                value={nb.id}
                selected={@selected_note && @selected_note.notebook_id == nb.id}
              >
                {nb.name}
              </option>
            </select>
          </div>
          <div>
            <label class="label">
              <span class="label-text font-medium">
                Tags <span class="font-normal text-base-content/50">(comma-separated)</span>
              </span>
            </label>
            <input
              type="text"
              name="tags_input"
              value={@tags_input}
              placeholder="elixir, distributed, papers"
              class="input input-bordered w-full rounded-lg"
            />
          </div>
          <div>
            <div class="flex items-end justify-between">
              <label class="label"><span class="label-text font-medium">Content</span></label>
              <div
                :if={markdown_note?(@selected_note)}
                class="flex items-center gap-0.5 rounded-lg bg-base-200 p-0.5 mb-1"
              >
                <button
                  type="button"
                  id="editor-tab-write"
                  phx-click="set_editor_tab"
                  phx-value-tab="write"
                  class={[
                    "press btn btn-xs rounded-md",
                    if(@editor_tab == :write, do: "btn-primary shadow-sm", else: "btn-ghost")
                  ]}
                >
                  Write
                </button>
                <button
                  type="button"
                  id="editor-tab-preview"
                  phx-click="set_editor_tab"
                  phx-value-tab="preview"
                  class={[
                    "press btn btn-xs rounded-md",
                    if(@editor_tab == :preview, do: "btn-primary shadow-sm", else: "btn-ghost")
                  ]}
                >
                  Preview
                </button>
              </div>
            </div>
            <div class="relative">
              <textarea
                id="note-body-input"
                name="note[body]"
                phx-hook=".WikilinkComplete"
                phx-debounce="300"
                class={[
                  "textarea textarea-bordered w-full h-64 font-mono text-sm leading-relaxed rounded-lg",
                  @editor_tab == :preview && "hidden"
                ]}
                placeholder="Note content..."
              >{@draft_body}</textarea>
              <script :type={Phoenix.LiveView.ColocatedHook} name=".WikilinkComplete">
                export default {
                  mounted() {
                    this.menu = document.getElementById("wikilink-menu")
                    this.items = []
                    this.index = 0
                    this.open = false

                    this.el.addEventListener("input", () => this.check())
                    this.el.addEventListener("blur", () => setTimeout(() => this.close(), 150))
                    this.el.addEventListener("keydown", (e) => {
                      if (!this.open) return
                      if (e.key === "ArrowDown") { e.preventDefault(); this.move(1) }
                      else if (e.key === "ArrowUp") { e.preventDefault(); this.move(-1) }
                      else if (e.key === "Enter" || e.key === "Tab") { e.preventDefault(); this.accept(this.items[this.index]) }
                      else if (e.key === "Escape") { e.stopPropagation(); this.close() }
                    })
                  },
                  destroyed() { this.close() },
                  check() {
                    const match = this.partial()
                    if (!match) return this.close()
                    this.pushEvent("wikilink_suggest", {q: match[1]}, ({suggestions}) => {
                      if (!suggestions || suggestions.length === 0) return this.close()
                      this.items = suggestions
                      this.index = 0
                      this.render()
                    })
                  },
                  partial() {
                    const upToCaret = this.el.value.slice(0, this.el.selectionStart)
                    return upToCaret.match(/\[\[([^\]\n]*)$/)
                  },
                  render() {
                    this.open = true
                    this.menu.classList.remove("hidden")
                    this.menu.innerHTML = ""
                    this.items.forEach((item, i) => {
                      const btn = document.createElement("button")
                      btn.type = "button"
                      btn.textContent = item.title
                      btn.className = "block w-full text-left px-3 py-1.5 text-sm truncate rounded-md" +
                        (i === this.index ? " bg-primary/10 text-primary" : "")
                      btn.addEventListener("mousedown", (e) => { e.preventDefault(); this.accept(item) })
                      this.menu.appendChild(btn)
                    })
                  },
                  move(delta) {
                    this.index = Math.min(Math.max(this.index + delta, 0), this.items.length - 1)
                    this.render()
                  },
                  accept(item) {
                    if (!item) return
                    const match = this.partial()
                    if (!match) return this.close()
                    const pos = this.el.selectionStart
                    const start = pos - match[1].length
                    const rest = this.el.value.slice(pos)
                    const closing = rest.startsWith("]]") ? "" : "]]"
                    this.el.value = this.el.value.slice(0, start) + item.title + closing + rest
                    const caret = start + item.title.length + 2
                    this.el.setSelectionRange(caret, caret)
                    this.el.dispatchEvent(new Event("input", {bubbles: true}))
                    this.el.focus()
                  },
                  close() {
                    this.open = false
                    this.items = []
                    if (this.menu) {
                      this.menu.classList.add("hidden")
                      this.menu.innerHTML = ""
                    }
                  }
                }
              </script>
              <div
                id="wikilink-menu"
                phx-update="ignore"
                class="hidden absolute left-0 right-0 top-full mt-1 z-20 rounded-xl border border-base-300 bg-base-100 shadow-xl p-1 max-h-56 overflow-y-auto"
              >
              </div>
              <div
                :if={@editor_tab == :preview && markdown_note?(@selected_note)}
                id="editor-preview"
                class="note-body text-sm leading-relaxed rounded-lg border border-base-300 bg-base-200/30 px-4 py-3 min-h-64"
              >
                <%= if String.trim(@draft_body) == "" do %>
                  <p class="text-base-content/40 italic">Nothing to preview yet.</p>
                <% else %>
                  {Phoenix.HTML.raw(@preview_html)}
                <% end %>
              </div>
            </div>
            <p :if={markdown_note?(@selected_note)} class="text-xs text-base-content/40 mt-1.5">
              Markdown supported. Link to another note with [[Title]] — typing [[ suggests notes.
            </p>
          </div>
          <div class="flex gap-2 pt-2">
            <button type="submit" class="press btn btn-primary">Save</button>
            <button type="button" phx-click="cancel_edit" class="press btn btn-ghost">
              Cancel
            </button>
            <button
              :if={@selected_note}
              type="button"
              phx-click="delete_note"
              data-confirm="Delete this note permanently?"
              class="press btn btn-error btn-outline ml-auto"
            >
              <.icon name="hero-trash" class="size-4" /> Delete
            </button>
          </div>
        </form>
      </div>

      <%!-- Note Viewer --%>
      <div
        :if={@selected_note && !@editing}
        class="max-w-2xl mx-auto px-4 py-6 md:px-8 md:py-10 prism-in"
      >
        <div class="flex items-start justify-between mb-2 gap-4">
          <h1 class="text-2xl font-bold leading-tight flex-1">
            {@selected_note.title || "(Untitled)"}
          </h1>
          <div class="flex items-center gap-1 shrink-0">
            <button phx-click="edit_note" class="press btn btn-ghost btn-sm gap-1.5">
              <.icon name="hero-pencil" class="size-4" /> Edit
            </button>
            <button
              phx-click="delete_note"
              data-confirm="Delete this note permanently?"
              class="press btn btn-ghost btn-sm hover:bg-error/10 hover:text-error"
              title="Delete"
            >
              <.icon name="hero-trash" class="size-4" />
            </button>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-2 text-sm text-base-content/50 mb-3">
          <select
            id="move-notebook-select"
            phx-change="move_note"
            class="select select-bordered select-xs rounded-lg"
          >
            <option value="" selected={is_nil(@selected_note.notebook_id)}>
              — no notebook —
            </option>
            <option
              :for={nb <- @notebooks}
              value={nb.id}
              selected={@selected_note.notebook_id == nb.id}
            >
              {nb.name}
            </option>
          </select>
          <span>{Calendar.strftime(@selected_note.inserted_at, "%B %-d, %Y")}</span>
          <a
            :if={@selected_note.source_url}
            href={@selected_note.source_url}
            target="_blank"
            rel="noopener noreferrer"
            class="link link-primary text-xs flex items-center gap-1"
          >
            <.icon name="hero-arrow-top-right-on-square" class="size-3" />
            {URI.parse(@selected_note.source_url).host}
          </a>
        </div>
        <div :if={@selected_note.tags != []} class="flex flex-wrap gap-1.5 mb-6">
          <span
            :for={tag <- @selected_note.tags}
            class="rounded-full bg-primary/10 text-primary px-2.5 py-0.5 text-xs font-medium"
          >
            {tag.name}
          </span>
        </div>
        <div :if={@selected_note.storage_key} class="mb-6">
          <a
            href={"/vault/files/#{@selected_note.storage_key}"}
            class="press btn btn-outline btn-sm gap-1.5"
          >
            <.icon name="hero-paper-clip" class="size-4" /> View attachment
          </a>
        </div>
        <%!-- Annotations --%>
        <section class="mt-6 pt-6 border-t border-base-300">
          <h2 class="text-sm font-bold uppercase tracking-wide text-base-content/50 mb-3 flex items-center gap-1.5">
            <.icon name="hero-chat-bubble-bottom-center-text" class="size-4" /> Annotations
          </h2>
          <div :if={@annotations != []} class="space-y-2 mb-3">
            <div
              :for={annotation <- @annotations}
              class="group flex items-start gap-2 rounded-lg bg-warning/5 border border-warning/20 px-3 py-2"
            >
              <p class="flex-1 text-sm leading-relaxed whitespace-pre-wrap">{annotation.body}</p>
              <div class="shrink-0 flex items-center gap-2">
                <span class="text-[10px] text-base-content/40 tabular-nums">
                  {Calendar.strftime(annotation.inserted_at, "%b %-d")}
                </span>
                <button
                  phx-click="delete_annotation"
                  phx-value-id={annotation.id}
                  class="press btn btn-ghost btn-xs opacity-0 group-hover:opacity-100 transition-opacity hover:text-error"
                  title="Delete annotation"
                >
                  <.icon name="hero-x-mark" class="size-3" />
                </button>
              </div>
            </div>
          </div>
          <form id="annotation-form" phx-submit="add_annotation" class="flex gap-2">
            <input
              type="text"
              name="body"
              placeholder="Add a thought about this note..."
              autocomplete="off"
              class="input input-bordered input-sm flex-1 rounded-lg"
            />
            <button type="submit" class="press btn btn-primary btn-sm rounded-lg">Add</button>
          </form>
        </section>

        <%!-- Connections --%>
        <section class="mt-8 pt-6 border-t border-base-300">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-bold uppercase tracking-wide text-base-content/50 flex items-center gap-1.5">
              <.icon name="hero-share" class="size-4" /> Connections
            </h2>
            <button
              phx-click="refresh_connections"
              class="press btn btn-ghost btn-xs gap-1"
              title="Rebuild connections for this note"
            >
              <.icon name="hero-arrow-path" class="size-3" /> Rebuild
            </button>
          </div>
          <p :if={@related == []} class="text-sm text-base-content/40 italic">
            No connections yet — they appear as the graph is built in the background.
          </p>
          <div :for={{kind_label, entries} <- group_related(@related)} class="mb-4 last:mb-0">
            <h3 class="text-xs font-semibold text-base-content/60 mb-1.5">{kind_label}</h3>
            <div class="space-y-1.5">
              <div
                :for={%{edge: edge, note: other} <- entries}
                class="group flex items-start gap-2 rounded-lg border border-base-300 hover:border-primary/40 hover:bg-primary/5 px-3 py-2 transition-colors"
              >
                <button
                  phx-click="select_note"
                  phx-value-id={other.id}
                  class="flex-1 min-w-0 text-left cursor-pointer"
                >
                  <p class="text-sm font-medium truncate">{other.title || "(Untitled)"}</p>
                  <p :if={edge.reason} class="text-xs text-base-content/60 mt-0.5 leading-snug">
                    {edge.reason}
                  </p>
                </button>
                <div class="shrink-0 flex items-center gap-1.5">
                  <span
                    class="text-[10px] tabular-nums text-base-content/40"
                    title={"#{edge.origin} edge"}
                  >
                    {round(edge.weight * 100)}%
                  </span>
                  <button
                    phx-click="delete_edge"
                    phx-value-id={edge.id}
                    class="press btn btn-ghost btn-xs opacity-0 group-hover:opacity-100 transition-opacity hover:text-error"
                    title="Remove this connection"
                  >
                    <.icon name="hero-x-mark" class="size-3" />
                  </button>
                </div>
              </div>
            </div>
          </div>
        </section>

        <%!-- Unlinked mentions --%>
        <section
          :if={@mentions != []}
          id="unlinked-mentions"
          class="mt-8 pt-6 border-t border-base-300"
        >
          <h2 class="text-sm font-bold uppercase tracking-wide text-base-content/50 mb-1 flex items-center gap-1.5">
            <.icon name="hero-link" class="size-4" /> Unlinked mentions
          </h2>
          <p class="text-xs text-base-content/40 mb-3">
            Notes that mention “{@selected_note.title}” without a connection.
          </p>
          <div class="space-y-1.5">
            <div
              :for={mention <- @mentions}
              class="group flex items-center gap-2 rounded-lg border border-base-300 hover:border-primary/40 hover:bg-primary/5 px-3 py-2 transition-colors"
            >
              <button
                phx-click="select_note"
                phx-value-id={mention.id}
                class="flex-1 min-w-0 text-left cursor-pointer"
              >
                <p class="text-sm font-medium truncate">{mention.title || "(Untitled)"}</p>
                <p class="text-xs text-base-content/50 mt-0.5">
                  {Calendar.strftime(mention.inserted_at, "%b %-d, %Y")}
                </p>
              </button>
              <button
                id={"link-mention-#{mention.id}"}
                phx-click="link_mention"
                phx-value-id={mention.id}
                class="press btn btn-outline btn-xs gap-1 shrink-0"
                title="Connect these notes"
              >
                <.icon name="hero-link" class="size-3" /> Link
              </button>
            </div>
          </div>
        </section>

        <div class="note-body prose-like text-base leading-relaxed mt-8 pt-6 border-t border-base-300">
          {Phoenix.HTML.raw(@rendered_body)}
        </div>
      </div>
    </main>
  </div>

  <%!-- Quick switcher (⌘K) --%>
  <div
    :if={@switcher_open}
    id="quick-switcher"
    class="fixed inset-0 z-50 flex items-start justify-center pt-[15vh] px-4"
  >
    <div
      class="absolute inset-0 bg-base-300/60 backdrop-blur-sm"
      phx-click="close_switcher"
      aria-hidden="true"
    >
    </div>
    <div class="relative w-full max-w-lg rounded-2xl border border-base-300 bg-base-100 shadow-2xl overflow-hidden prism-in">
      <form phx-change="switcher_search" phx-submit="switcher_submit">
        <div class="relative border-b border-base-300">
          <.icon
            name="hero-magnifying-glass"
            class="size-4 text-base-content/40 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none"
          />
          <input
            id="switcher-input"
            type="text"
            name="q"
            value={@switcher_query}
            placeholder="Jump to note…"
            autocomplete="off"
            phx-keydown="switcher_keydown"
            phx-debounce="150"
            phx-mounted={JS.focus()}
            class="w-full bg-transparent pl-11 pr-4 py-3.5 text-sm focus:outline-none"
          />
        </div>
      </form>
      <div id="switcher-results" class="max-h-72 overflow-y-auto p-1.5">
        <p
          :if={@switcher_results == []}
          class="px-3 py-6 text-center text-sm text-base-content/40"
        >
          No matching notes
        </p>
        <button
          :for={{note, i} <- Enum.with_index(@switcher_results)}
          phx-click="switcher_select"
          phx-value-id={note.id}
          class={[
            "flex w-full items-center justify-between gap-3 rounded-lg px-3 py-2 text-left transition-colors",
            if(i == @switcher_index, do: "bg-primary/10 text-primary", else: "hover:bg-base-200")
          ]}
        >
          <span class="text-sm font-medium truncate">{note.title}</span>
          <span class="text-xs text-base-content/40 tabular-nums shrink-0">
            {Calendar.strftime(note.inserted_at, "%b %-d, %Y")}
          </span>
        </button>
      </div>
      <div class="border-t border-base-300 px-4 py-2 text-[11px] text-base-content/40 flex items-center gap-3">
        <span>↑↓ navigate</span>
        <span>↵ open</span>
        <span>esc close</span>
      </div>
    </div>
  </div>
</Layouts.vault>
