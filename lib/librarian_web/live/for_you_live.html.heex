<Layouts.reader flash={@flash}>
  <div class="flex flex-col h-full overflow-hidden bg-base-200/40">
    <%!-- TOP BAR --%>
    <header class="shrink-0 border-b border-base-300 bg-gradient-to-r from-primary/10 via-base-100 to-base-100 backdrop-blur">
      <div class="px-4 md:px-6 py-3 flex flex-wrap items-center gap-x-4 gap-y-2">
        <div class="flex items-center gap-2.5">
          <div class="size-9 rounded-xl bg-primary/15 text-primary grid place-items-center">
            <.icon name="hero-sparkles" class="size-5" />
          </div>
          <div class="leading-tight">
            <h1 class="text-base font-bold tracking-tight">For You</h1>
            <p class="text-[11px] text-base-content/50">
              {@count} ranked · {@centroid_count} interest clusters
            </p>
          </div>
        </div>

        <div class="hidden sm:flex items-center gap-1.5 ml-2">
          <span class="inline-flex items-center gap-1 rounded-full bg-success/10 text-success px-2 py-0.5 text-xs font-medium">
            <.icon name="hero-hand-thumb-up-solid" class="size-3" /> {Map.get(@summary, "like", 0)}
          </span>
          <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 text-primary px-2 py-0.5 text-xs font-medium">
            <.icon name="hero-bookmark-solid" class="size-3" /> {Map.get(@summary, "save", 0)}
          </span>
          <span class="inline-flex items-center gap-1 rounded-full bg-error/10 text-error px-2 py-0.5 text-xs font-medium">
            <.icon name="hero-hand-thumb-down-solid" class="size-3" /> {Map.get(
              @summary,
              "dislike",
              0
            )}
          </span>
        </div>

        <button
          id="discover-open"
          phx-click="toggle_discover"
          class="press btn btn-ghost btn-sm gap-1.5"
        >
          <.icon name="hero-magnifying-glass-plus" class="size-4" />
          <span class="hidden sm:inline">Discover</span>
        </button>

        <Layouts.nav_pills active={:for_you} class="ml-auto" />
      </div>

      <%!-- LENS CHIPS: pinned category lenses first, then pool topics --%>
      <div
        :if={@topics != [] or @lenses != []}
        class="px-4 md:px-6 pb-3 flex items-center gap-1.5 flex-wrap"
      >
        <span class="text-[11px] uppercase tracking-wider text-base-content/40 mr-1">Lenses</span>
        <button
          :for={lens <- @lenses}
          id={"lens-#{String.replace(lens, ~r/\W+/, "-")}"}
          phx-click="filter_category"
          phx-value-category={lens}
          class={[
            "press rounded-full px-3 py-1 text-xs font-medium transition inline-flex items-center gap-1",
            if(@active_category == lens,
              do: "bg-primary text-primary-content shadow-sm",
              else:
                "bg-primary/5 border border-primary/30 text-base-content/70 hover:border-primary/60 hover:text-base-content"
            )
          ]}
        >
          <.icon name="hero-bolt" class="size-3" />
          {lens}
        </button>
        <button
          :for={topic <- @topics}
          phx-click="filter_topic"
          phx-value-topic={topic}
          class={[
            "press rounded-full px-3 py-1 text-xs font-medium transition",
            if(@active_topic == topic,
              do: "bg-primary text-primary-content shadow-sm",
              else:
                "bg-base-100 border border-base-300 text-base-content/70 hover:border-primary/40 hover:text-base-content"
            )
          ]}
        >
          {topic}
        </button>
        <button
          :if={@active_topic}
          phx-click="filter_topic"
          phx-value-topic={@active_topic}
          class="press rounded-full px-2 py-1 text-xs text-base-content/40 hover:text-error transition"
          title="Clear lens"
        >
          <.icon name="hero-x-mark" class="size-3.5" />
        </button>
        <button
          :if={@active_category}
          phx-click="filter_category"
          phx-value-category={@active_category}
          class="press rounded-full px-2 py-1 text-xs text-base-content/40 hover:text-error transition"
          title="Clear lens"
        >
          <.icon name="hero-x-mark" class="size-3.5" />
        </button>
      </div>
    </header>

    <%!-- STREAM --%>
    <div class="flex-1 overflow-y-auto">
      <div class="max-w-2xl mx-auto px-4 py-6 space-y-3">
        <div :if={@empty?} class="text-center text-base-content/50 py-24 prism-in">
          <div class="size-16 mx-auto rounded-2xl bg-primary/10 text-primary grid place-items-center mb-5">
            <.icon name="hero-sparkles" class="size-8" />
          </div>
          <p class="text-lg font-medium text-base-content/70">Your stream is still learning</p>
          <p class="text-sm mt-2 max-w-sm mx-auto">
            Like or save a few articles in the
            <.link navigate="/reader" class="link link-primary">Reader</.link>
            and they'll shape what shows up here.
          </p>
        </div>

        <div id="for-you-stream" phx-update="stream" class="space-y-3">
          <article
            :for={{dom_id, entry} <- @streams.entries}
            id={dom_id}
            class={[
              "stream-card prism-in group rounded-xl bg-base-100 border overflow-hidden flex",
              if(entry.exploration,
                do: "border-dashed border-secondary/40",
                else: "border-base-300"
              )
            ]}
          >
            <% {bar, pill} =
              cond do
                entry.score >= 0.6 -> {"bg-success", "bg-success/15"}
                entry.score >= 0.35 -> {"bg-primary", "bg-primary/15"}
                true -> {"bg-base-300", "bg-base-200"}
              end %>
            <div class={["w-1 shrink-0", bar]}></div>

            <div class="flex-1 p-4">
              <div class="flex items-center gap-2 text-xs text-base-content/50 mb-1.5">
                <span class="inline-flex items-center gap-1.5 font-medium text-base-content/70">
                  <span class={["size-1.5 rounded-full", bar]}></span>
                  {entry.article.feed && entry.article.feed.title}
                </span>
                <span
                  :if={entry.article.content_type}
                  class="rounded bg-base-200 px-1.5 py-0.5 text-[10px] uppercase tracking-wide"
                >
                  {entry.article.content_type}
                </span>
                <span :if={entry.article.published_at} class="text-base-content/40">
                  {Calendar.strftime(entry.article.published_at, "%b %d")}
                </span>
                <div class="ml-auto flex items-center gap-1.5">
                  <span
                    :if={entry.article.read_state && entry.article.read_state.read_at}
                    class="inline-flex items-center gap-1 rounded-full bg-base-200 px-2 py-0.5 text-[10px] font-semibold text-base-content/50"
                  >
                    <.icon name="hero-check" class="size-3" /> Read
                  </span>
                  <span
                    :if={entry.exploration}
                    class="inline-flex items-center gap-1 rounded-full bg-secondary/15 text-secondary px-2 py-0.5 text-[10px] font-semibold"
                  >
                    <.icon name="hero-beaker" class="size-3" /> explore
                  </span>
                  <span class={[
                    "rounded-full px-2 py-0.5 text-[11px] font-bold tabular-nums text-base-content/70",
                    pill
                  ]}>
                    {:erlang.float_to_binary(entry.score, decimals: 2)}
                  </span>
                </div>
              </div>

              <h2 class="text-[15px] font-semibold leading-snug mb-2">
                <a
                  href={entry.article.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  phx-click={
                    JS.push("open", value: %{id: entry.article.id})
                    |> JS.add_class("opacity-60", to: "##{dom_id}")
                  }
                  class="hover:text-primary transition-colors"
                >
                  {entry.article.title || entry.article.url || "(no title)"}
                </a>
              </h2>

              <div :if={entry.article.topics != []} class="flex flex-wrap gap-1 mb-2">
                <span
                  :for={topic <- entry.article.topics}
                  class="rounded-full bg-primary/10 text-primary px-2 py-0.5 text-[10px] font-medium"
                >
                  {topic}
                </span>
              </div>

              <%!-- LINK PREVIEW / GRAPH CARD (rendered only when metadata exists) --%>
              <a
                :if={entry.preview}
                href={entry.article.url}
                target="_blank"
                rel="noopener noreferrer"
                class="press block rounded-lg border border-base-300 overflow-hidden mb-3 hover:border-primary/40 transition-colors"
              >
                <img
                  :if={entry.preview.image}
                  src={entry.preview.image}
                  alt=""
                  loading="lazy"
                  class="w-full h-40 object-cover bg-base-200"
                />
                <div class="flex items-start gap-2.5 p-3 bg-base-200/40">
                  <img
                    :if={entry.preview.favicon}
                    src={entry.preview.favicon}
                    alt=""
                    loading="lazy"
                    class="size-5 rounded shrink-0 mt-0.5"
                  />
                  <div class="min-w-0">
                    <div class="text-[11px] uppercase tracking-wide text-base-content/45 truncate">
                      {entry.preview.site_name || entry.preview.domain}
                      <span
                        :if={entry.preview.site_name && entry.preview.domain}
                        class="opacity-60"
                      >
                        · {entry.preview.domain}
                      </span>
                    </div>
                    <p
                      :if={entry.preview.description}
                      class="text-xs text-base-content/65 leading-snug line-clamp-2 mt-0.5"
                    >
                      {entry.preview.description}
                    </p>
                  </div>
                </div>
              </a>

              <p class="text-xs text-base-content/45 mb-3 flex items-center gap-1.5">
                <.icon name="hero-information-circle" class="size-3.5 shrink-0" /> {entry.why}
              </p>

              <div class="flex items-center gap-1 opacity-70 group-hover:opacity-100 transition-opacity">
                <button
                  phx-click="feedback"
                  phx-value-id={entry.article.id}
                  phx-value-kind="like"
                  class="press btn btn-xs btn-ghost gap-1 hover:bg-success/10 hover:text-success"
                >
                  <.icon name="hero-hand-thumb-up" class="size-3.5" /> Like
                </button>
                <button
                  phx-click="feedback"
                  phx-value-id={entry.article.id}
                  phx-value-kind="dislike"
                  class="press btn btn-xs btn-ghost gap-1 hover:bg-error/10 hover:text-error"
                >
                  <.icon name="hero-hand-thumb-down" class="size-3.5" /> Dislike
                </button>
                <button
                  phx-click="feedback"
                  phx-value-id={entry.article.id}
                  phx-value-kind="save"
                  class="press btn btn-xs btn-ghost gap-1 hover:bg-primary/10 hover:text-primary"
                >
                  <.icon name="hero-bookmark" class="size-3.5" /> Save
                </button>
                <button
                  phx-click="feedback"
                  phx-value-id={entry.article.id}
                  phx-value-kind="done"
                  class="press btn btn-xs btn-ghost gap-1 ml-auto hover:bg-base-300"
                >
                  <.icon name="hero-check-circle" class="size-3.5" /> Done
                </button>
              </div>
            </div>
          </article>
        </div>
      </div>
    </div>
  </div>

  <%!-- DISCOVER POPUP --%>
  <div
    :if={@show_discover}
    id="discover-popup"
    class="fixed inset-0 z-50 flex items-start justify-center p-4 pt-16 md:pt-24"
  >
    <div
      id="discover-backdrop"
      class="absolute inset-0 bg-base-300/60 backdrop-blur-sm"
      phx-click="toggle_discover"
    >
    </div>
    <div class="relative w-full max-w-lg rounded-2xl border border-base-300 bg-base-100 shadow-xl">
      <div class="flex items-center justify-between px-5 pt-4 pb-2">
        <h2 class="text-base font-bold flex items-center gap-2">
          <.icon name="hero-magnifying-glass-plus" class="size-4 text-primary" /> Discover
        </h2>
        <button
          id="discover-close"
          phx-click="toggle_discover"
          class="btn btn-ghost btn-xs btn-square"
          aria-label="Close"
        >
          <.icon name="hero-x-mark" class="size-4" />
        </button>
      </div>

      <div class="px-5 pb-5 space-y-4">
        <div>
          <p class="text-xs text-base-content/50 mb-2">
            Name an area to explore — sources are found, vetted, and subscribed on probation
            under that category. Ones you ignore get pruned.
          </p>
          <form id="explore-intent-form" phx-submit="explore_intent" class="flex gap-2">
            <input
              type="text"
              name="query"
              placeholder="marine insurance, urban planning, woodworking…"
              class="input input-bordered input-sm flex-1"
              required
              disabled={!@llm_ready}
            />
            <button
              id="explore-intent-submit"
              type="submit"
              class="btn btn-primary btn-sm gap-1"
              disabled={!@llm_ready}
            >
              <.icon name="hero-sparkles" class="w-4 h-4" /> Explore
            </button>
          </form>
          <p :if={!@llm_ready} class="text-xs text-base-content/40 mt-1.5">
            Needs an Anthropic API key — add one in Settings → AI.
          </p>
        </div>

        <label class="flex items-center justify-between gap-3 rounded-lg bg-base-200 px-3 py-2 cursor-pointer">
          <span class="text-sm">
            Pause automatic discovery
            <span class="block text-xs text-base-content/45">
              Stops the nightly link-graph and aggregator mining. Exploring by name still works.
            </span>
          </span>
          <input
            id="discovery-pause-toggle"
            type="checkbox"
            class="toggle toggle-sm toggle-primary"
            checked={@discovery_paused}
            phx-click="toggle_discovery_paused"
          />
        </label>

        <div :if={@discover_candidates != []}>
          <p class="text-[11px] uppercase tracking-wider text-base-content/40 mb-1.5">
            In the pipeline
          </p>
          <ul class="space-y-1 max-h-64 overflow-y-auto">
            <li
              :for={c <- @discover_candidates}
              class="flex items-center gap-2 rounded-lg bg-base-200/60 px-3 py-1.5 text-sm"
            >
              <span class="truncate font-medium">{c.domain}</span>
              <span
                :if={c.channel == "intent" && c.intent_query}
                class="truncate rounded-full bg-primary/10 text-primary px-2 py-0.5 text-[10px]"
              >
                {c.intent_query}
              </span>
              <span class={[
                "ml-auto shrink-0 rounded-full px-2 py-0.5 text-[10px] font-medium",
                candidate_status_class(c.status)
              ]}>
                {c.status}
              </span>
              <button
                :if={c.status in ["pending", "vetting"]}
                id={"dismiss-candidate-#{c.id}"}
                phx-click="dismiss_candidate"
                phx-value-id={c.id}
                class="btn btn-ghost btn-xs btn-square shrink-0"
                aria-label="Dismiss"
              >
                <.icon name="hero-x-mark" class="size-3.5" />
              </button>
            </li>
          </ul>
        </div>
        <p :if={@discover_candidates == []} class="text-xs text-base-content/40">
          Nothing in the pipeline right now.
        </p>
      </div>
    </div>
  </div>
</Layouts.reader>
