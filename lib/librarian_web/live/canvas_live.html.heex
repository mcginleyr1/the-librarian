<Layouts.reader flash={@flash}>
  <%= if @live_action == :index do %>
    <div class="flex flex-col h-full overflow-hidden bg-base-100">
      <header class="shrink-0 border-b border-base-300 bg-gradient-to-r from-primary/10 via-base-100 to-base-100 px-4 md:px-6 py-3 flex flex-wrap items-center gap-x-4 gap-y-2">
        <div class="flex items-center gap-2.5">
          <div class="size-9 rounded-xl bg-primary/15 text-primary grid place-items-center">
            <.icon name="hero-squares-plus" class="size-5" />
          </div>
          <div class="leading-tight">
            <h1 class="text-base font-bold tracking-tight">Canvas</h1>
            <p class="text-[11px] text-base-content/50">
              {length(@pages)} {if length(@pages) == 1, do: "page", else: "pages"}
            </p>
          </div>
        </div>
        <button id="new-page" phx-click="new_page" class="press btn btn-primary btn-sm gap-1.5">
          <.icon name="hero-plus" class="size-4" /> New page
        </button>
        <Layouts.nav_pills active={:canvas} class="ml-auto" />
      </header>

      <main class="flex-1 min-h-0 overflow-y-auto p-4 md:p-6">
        <div
          :if={@pages == []}
          class="h-full grid place-items-center text-base-content/40 select-none"
        >
          <div class="text-center max-w-sm">
            <div class="size-16 mx-auto rounded-2xl bg-base-200 grid place-items-center mb-4">
              <.icon name="hero-squares-plus" class="size-8" />
            </div>
            <p class="text-lg font-medium">No pages yet</p>
            <p class="text-sm mt-1">
              Start a page here, or open a note in the vault and hit Compose.
            </p>
          </div>
        </div>

        <div :if={@pages != []} class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          <div
            :for={page <- @pages}
            id={"page-#{page.id}"}
            class="stream-card group relative rounded-2xl border border-base-300 bg-base-100 p-4"
          >
            <.link navigate={"/canvas/#{page.id}"} class="block min-w-0">
              <h2 class="font-semibold truncate pr-8">{page.title}</h2>
              <p class="text-xs text-base-content/50 mt-1">
                {card_count(page.doc)} {if card_count(page.doc) == 1, do: "card", else: "cards"} · {Calendar.strftime(
                  page.updated_at,
                  "%b %-d"
                )}
              </p>
              <p
                :if={page.root_note}
                class="mt-3 flex items-center gap-1.5 text-xs text-base-content/60 truncate"
              >
                <.icon name="hero-document-text" class="size-3.5 shrink-0 text-primary" />
                {page.root_note.title || "(Untitled)"}
              </p>
            </.link>
            <button
              phx-click="delete_page"
              phx-value-id={page.id}
              data-confirm="Delete this page? Notes on it stay in the vault."
              title="Delete page"
              class="press btn btn-ghost btn-xs btn-square absolute top-2 right-2 opacity-50 group-hover:opacity-100 transition-opacity hover:text-error"
            >
              <.icon name="hero-trash" class="size-3.5" />
            </button>
          </div>
        </div>
      </main>
    </div>
  <% else %>
    <div class="flex flex-col h-full overflow-hidden bg-base-100">
      <header class="shrink-0 border-b border-base-300 bg-gradient-to-r from-primary/10 via-base-100 to-base-100 px-4 md:px-6 py-2.5 flex items-center gap-3">
        <.link navigate="/canvas" class="press btn btn-ghost btn-xs rounded-full gap-1 shrink-0">
          <.icon name="hero-arrow-left" class="size-3" /> Pages
        </.link>
        <form
          id="page-title-form"
          phx-change="rename"
          phx-submit="rename"
          class="min-w-0 flex-1 max-w-md"
        >
          <input
            id="page-title"
            name="title"
            value={@page.title}
            phx-debounce="500"
            autocomplete="off"
            class="w-full bg-transparent font-bold tracking-tight text-base truncate border-b border-transparent focus:border-primary/40 focus:outline-none"
          />
        </form>
        <Layouts.nav_pills active={:canvas} class="ml-auto max-md:hidden" />
        <button
          id="delete-page"
          phx-click="delete_page"
          phx-value-id={@page.id}
          data-confirm="Delete this page? Notes on it stay in the vault."
          title="Delete page"
          class="press btn btn-ghost btn-xs btn-square shrink-0 text-base-content/50 hover:text-error"
        >
          <.icon name="hero-trash" class="size-4" />
        </button>
      </header>

      <div class="flex-1 min-h-0 relative overflow-hidden canvas-grid">
        <div
          id="canvas-board"
          phx-hook="Canvas"
          data-page-id={@page.id}
          class="absolute inset-0 overflow-hidden touch-none select-none text-base-content"
        >
          <div data-viewport class="absolute top-0 left-0 origin-top-left will-change-transform">
            <svg
              id="canvas-edges"
              phx-update="ignore"
              data-edges={Jason.encode!(@doc["edges"])}
              class="absolute top-0 left-0 overflow-visible pointer-events-none"
              width="1"
              height="1"
            >
            </svg>

            <div
              :for={node <- ordered_nodes(@doc)}
              id={"node-#{node["id"]}"}
              data-node-id={node["id"]}
              data-node-type={node["type"]}
              data-x={node["x"]}
              data-y={node["y"]}
              data-resize={
                if(framed?(node, @notes[Canvas.note_id(node)]), do: "both", else: "width")
              }
              class={[
                "absolute top-0 left-0 group rounded-xl transition-[box-shadow,border-color] duration-150",
                card_chrome(node["type"])
              ]}
              style={card_style(node, @notes[Canvas.note_id(node)])}
            >
              <div
                data-handle="move"
                title="Drag to move"
                class="absolute -top-1.5 inset-x-3 h-3 rounded-full cursor-grab opacity-0 group-hover:opacity-100 transition-opacity bg-base-content/15 hover:bg-primary/60 z-10"
              >
              </div>
              <div
                data-handle="resize"
                title="Drag to resize"
                class="absolute -right-1.5 top-1/2 -translate-y-1/2 w-3 h-8 rounded-full cursor-ew-resize opacity-0 group-hover:opacity-100 transition-opacity bg-base-content/15 hover:bg-primary/60 z-10"
              >
              </div>
              <button
                :for={side <- ~w(top right bottom left)}
                :if={node["type"] != "group"}
                type="button"
                data-port={side}
                title="Drag to connect"
                class={[
                  "absolute size-4 rounded-full border-2 border-primary bg-base-100 cursor-crosshair opacity-0 group-hover:opacity-100 transition-opacity hover:scale-125 hover:bg-primary z-20",
                  side == "top" && "-top-6 left-1/2 -translate-x-1/2",
                  side == "bottom" && "-bottom-6 left-1/2 -translate-x-1/2",
                  side == "left" && "-left-6 top-1/2 -translate-y-1/2",
                  side == "right" && "-right-6 top-1/2 -translate-y-1/2"
                ]}
              >
              </button>

              <%= case node["type"] do %>
                <% "text" -> %>
                  <%= if @editing_node_id == node["id"] do %>
                    <form
                      id={"text-form-#{node["id"]}"}
                      phx-change="update_text"
                      class="relative p-3"
                    >
                      <input type="hidden" name="node_id" value={node["id"]} />
                      <textarea
                        id={"text-input-#{node["id"]}"}
                        name="text"
                        rows="1"
                        placeholder="Type here…  [[ links a note"
                        phx-hook="WikilinkComplete"
                        data-menu={"wikilink-menu-#{node["id"]}"}
                        phx-mounted={JS.focus()}
                        phx-debounce="400"
                        phx-blur="stop_editing"
                        phx-keydown="stop_editing"
                        phx-key="Escape"
                        phx-value-id={node["id"]}
                        class="w-full resize-none bg-transparent text-sm leading-relaxed focus:outline-none select-text"
                      >{node["text"]}</textarea>
                      <div
                        id={"wikilink-menu-#{node["id"]}"}
                        phx-update="ignore"
                        class="hidden absolute left-2 right-2 top-full z-30 rounded-xl border border-base-300 bg-base-100 shadow-xl p-1 max-h-56 overflow-y-auto"
                      >
                      </div>
                    </form>
                  <% else %>
                    <div
                      data-body
                      phx-dblclick="edit_text"
                      phx-value-id={node["id"]}
                      title="Double-click to edit"
                      class="note-body p-3 text-sm leading-relaxed select-text min-h-10 cursor-text"
                    >
                      {text_html(node["text"])}
                    </div>
                    <button
                      type="button"
                      phx-click="promote_node"
                      phx-value-id={node["id"]}
                      title="Save this card as a vault note"
                      class="press absolute -top-3 right-2 z-20 opacity-0 group-hover:opacity-100 transition-opacity rounded-full border border-base-300 bg-base-100 shadow px-2 py-0.5 text-[10px] font-semibold text-base-content/60 hover:text-primary hover:border-primary/50 flex items-center gap-1"
                    >
                      <.icon name="hero-document-plus" class="size-3" /> Save as note
                    </button>
                  <% end %>
                <% "file" -> %>
                  <%= if note = @notes[Canvas.note_id(node)] do %>
                    <div class="flex items-center gap-2 px-3 py-2 border-b border-base-300/70 shrink-0">
                      <.icon name={clip_icon(note)} class="size-3.5 text-primary shrink-0" />
                      <h3 class="text-sm font-semibold truncate flex-1 select-text">
                        {note.title || "(Untitled)"}
                      </h3>
                      <.link
                        navigate={"/vault/note/#{note.id}"}
                        title="Open in vault"
                        class="opacity-0 group-hover:opacity-100 transition-opacity text-base-content/50 hover:text-primary"
                      >
                        <.icon name="hero-arrow-top-right-on-square" class="size-3.5" />
                      </.link>
                    </div>
                    <div data-body class="select-text flex-1 min-h-0">
                      <%= cond do %>
                        <% note.clip_mode == "pdf" -> %>
                          <iframe
                            src={Storage.url(note.storage_key)}
                            title={note.title}
                            class="block w-full h-full rounded-b-xl"
                          >
                          </iframe>
                        <% note.clip_mode == "full_page" -> %>
                          <iframe
                            sandbox
                            src={Storage.url(note.storage_key)}
                            title={note.title}
                            class="block w-full h-full rounded-b-xl bg-white"
                          >
                          </iframe>
                        <% note.clip_mode in ~w(screenshot image) -> %>
                          <img
                            src={Storage.url(note.storage_key)}
                            alt={note.title}
                            class="block w-full rounded-b-xl"
                          />
                        <% true -> %>
                          <div class="note-body p-3 text-sm leading-relaxed max-h-96 overflow-y-auto">
                            {note_html(note)}
                          </div>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="p-3 text-sm text-base-content/40 italic">Note not found</div>
                  <% end %>
                <% "link" -> %>
                  <a
                    data-body
                    href={safe_url(node["url"])}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block p-3 select-text"
                  >
                    <span class="flex items-center gap-1.5 text-xs text-base-content/50">
                      <.icon name="hero-link" class="size-3.5" /> {URI.parse(node["url"]).host}
                    </span>
                    <span class="block text-sm text-primary truncate mt-1">{node["url"]}</span>
                  </a>
                <% "group" -> %>
                  <div class="px-3 py-1.5 text-[11px] font-semibold uppercase tracking-wide text-primary/70 select-text">
                    {node["label"]}
                  </div>
              <% end %>
            </div>
          </div>

          <div
            :if={@edge_editor}
            id="edge-editor"
            data-ui
            phx-click-away="close_edge_editor"
            class="absolute z-30 w-64 rounded-xl border border-base-300 bg-base-100/95 backdrop-blur shadow-xl p-2 prism-in"
            style={"left:calc(#{@edge_editor.x}px - 8rem);top:calc(#{@edge_editor.y}px + 12px)"}
          >
            <div class="flex flex-wrap gap-1 mb-2">
              <button
                :for={kind <- edge_kinds()}
                type="button"
                phx-click="update_edge"
                phx-value-edge_id={@edge_editor.id}
                phx-value-label={kind}
                class={[
                  "press rounded-full px-2 py-0.5 text-[11px] font-medium border transition",
                  if(Canvas.find_edge(@doc, @edge_editor.id)["label"] == kind,
                    do: "bg-primary text-primary-content border-primary",
                    else: "border-base-300 hover:border-primary/50 hover:text-primary"
                  )
                ]}
              >
                {String.replace(kind, "_", " ")}
              </button>
            </div>
            <form id="edge-label-form" phx-submit="update_edge" class="flex items-center gap-1">
              <input type="hidden" name="edge_id" value={@edge_editor.id} />
              <input
                id="edge-label"
                name="label"
                value={Canvas.find_edge(@doc, @edge_editor.id)["label"]}
                placeholder="Label this arrow…"
                autocomplete="off"
                phx-mounted={JS.focus()}
                class="flex-1 min-w-0 rounded-lg border border-base-300 bg-base-100 px-2 py-1 text-xs focus:outline-none focus:border-primary/50"
              />
              <button
                type="submit"
                title="Save label"
                class="press btn btn-primary btn-xs btn-square"
              >
                <.icon name="hero-check" class="size-3.5" />
              </button>
              <button
                type="button"
                phx-click="delete_edge"
                phx-value-id={@edge_editor.id}
                title="Remove arrow"
                class="press btn btn-ghost btn-xs btn-square hover:text-error"
              >
                <.icon name="hero-trash" class="size-3.5" />
              </button>
            </form>
          </div>

          <div data-ui class="absolute top-3 right-3 z-10 flex flex-col gap-1">
            <button
              id="drawer-toggle"
              phx-click="toggle_drawer"
              title="Add a note from the vault"
              class={[
                "btn btn-sm btn-square border border-base-300 backdrop-blur shadow",
                if(@drawer_open, do: "bg-primary text-primary-content", else: "bg-base-100/90")
              ]}
            >
              <.icon name="hero-document-plus" class="size-4" />
            </button>
            <button
              data-zoom="in"
              title="Zoom in"
              class="btn btn-sm btn-square border border-base-300 bg-base-100/90 backdrop-blur shadow"
            >
              <.icon name="hero-plus" class="size-4" />
            </button>
            <button
              data-zoom="out"
              title="Zoom out"
              class="btn btn-sm btn-square border border-base-300 bg-base-100/90 backdrop-blur shadow"
            >
              <.icon name="hero-minus" class="size-4" />
            </button>
            <button
              data-zoom="fit"
              title="Fit everything"
              class="btn btn-sm btn-square border border-base-300 bg-base-100/90 backdrop-blur shadow"
            >
              <.icon name="hero-viewfinder-circle" class="size-4" />
            </button>
          </div>

          <aside
            :if={@drawer_open}
            id="vault-drawer"
            data-ui
            class="absolute top-3 bottom-3 right-14 z-20 w-72 max-w-[calc(100%-5rem)] flex flex-col rounded-2xl border border-base-300 bg-base-100/95 backdrop-blur shadow-xl prism-in"
          >
            <form
              phx-change="drawer_search"
              phx-submit="drawer_search"
              class="p-2 border-b border-base-300"
            >
              <div class="relative">
                <.icon
                  name="hero-magnifying-glass"
                  class="size-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none"
                />
                <input
                  id="drawer-search"
                  name="q"
                  value={@drawer_query}
                  placeholder="Find a note to add…"
                  autocomplete="off"
                  phx-debounce="150"
                  phx-mounted={JS.focus()}
                  class="w-full rounded-full border border-base-300 bg-base-100 pl-8 pr-3 py-1.5 text-sm placeholder:text-base-content/40 focus:outline-none focus:border-primary/50"
                />
              </div>
            </form>
            <ul id="drawer-results" class="flex-1 min-h-0 overflow-y-auto p-1">
              <li
                :if={@drawer_results == []}
                class="px-3 py-6 text-center text-xs text-base-content/40"
              >
                No notes match
              </li>
              <li :for={note <- @drawer_results}>
                <button
                  type="button"
                  draggable="true"
                  data-drawer-note={note.id}
                  title="Click to add at the centre, or drag onto the page"
                  class="w-full text-left flex items-start gap-2 rounded-xl px-3 py-2 hover:bg-primary/10 cursor-grab active:cursor-grabbing"
                >
                  <.icon name={clip_icon(note)} class="size-3.5 mt-0.5 shrink-0 text-primary" />
                  <span class="min-w-0">
                    <span class="block text-sm font-medium truncate">{note.title}</span>
                    <span class="block text-[11px] text-base-content/50">
                      {Calendar.strftime(note.inserted_at, "%b %-d, %Y")}
                    </span>
                  </span>
                </button>
              </li>
            </ul>
            <p class="px-3 py-2 border-t border-base-300 text-[11px] text-base-content/40">
              Or paste an image, a link, or text anywhere on the page.
            </p>
          </aside>

          <form id="canvas-upload" phx-change="validate_upload" class="hidden">
            <.live_file_input upload={@uploads.images} />
          </form>

          <p
            data-ui
            class="absolute bottom-3 left-1/2 -translate-x-1/2 whitespace-nowrap text-[11px] text-base-content/40 pointer-events-none max-md:hidden"
          >
            click anywhere to type · drag a card's top edge to move · drag a side dot to connect · scroll to pan · ⌘ scroll to zoom
          </p>
        </div>
      </div>
    </div>
  <% end %>
</Layouts.reader>
