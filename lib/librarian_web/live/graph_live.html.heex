<Layouts.reader flash={@flash}>
  <div class="flex flex-col h-full overflow-hidden bg-[#0a0d18]">
    <header class="shrink-0 border-b border-white/5 bg-[#0d1120] px-6 py-3 flex items-center gap-4">
      <div class="flex items-center gap-2.5">
        <div class="size-9 rounded-xl bg-indigo-400/15 text-indigo-300 grid place-items-center">
          <.icon name="hero-share" class="size-5" />
        </div>
        <div class="leading-tight">
          <h1 class="text-base font-bold tracking-tight text-slate-100">Knowledge Graph</h1>
          <p class="text-[11px] text-slate-400">
            {@node_count} notes · {@typed_count} typed links · {@similarity_count} similarity threads
          </p>
        </div>
      </div>
      <.link
        navigate="/vault"
        class="press btn btn-ghost btn-xs rounded-full gap-1 text-slate-300 hover:text-slate-100"
      >
        <.icon name="hero-arrow-left" class="size-3" /> Vault
      </.link>
      <Layouts.nav_pills active={:graph} class="ml-auto" />
    </header>

    <div class="flex-1 min-h-0 relative overflow-hidden">
      <div
        :if={@loading}
        class="absolute inset-0 z-20 grid place-items-center text-slate-500 bg-[#0a0d18]"
      >
        <div class="text-center select-none">
          <span class="loading loading-ring loading-lg text-indigo-400"></span>
          <p class="mt-2 text-sm">Charting the sky…</p>
        </div>
      </div>

      <div
        :if={!@loading && @node_count == 0}
        class="absolute inset-0 z-20 grid place-items-center text-slate-500 bg-[#0a0d18]"
      >
        <div class="text-center select-none max-w-sm">
          <div class="size-16 mx-auto rounded-2xl bg-white/5 grid place-items-center mb-4">
            <.icon name="hero-share" class="size-8" />
          </div>
          <p class="text-lg font-medium text-slate-300">No stars yet</p>
          <p class="text-sm mt-1">
            Connections build in the background once your API key is set — similarity
            threads appear within the hour, typed links as Claude works through the vault.
          </p>
        </div>
      </div>

      <div
        id="graph-canvas"
        phx-hook="Constellation"
        phx-update="ignore"
        class="absolute inset-0 cursor-grab select-none touch-none"
      >
        <canvas class="absolute inset-0 w-full h-full"></canvas>

        <div
          data-tooltip
          class="pointer-events-none absolute top-0 left-0 z-10 hidden w-56 rounded-xl border border-white/10 bg-[#131829]/90 backdrop-blur px-3 py-2 shadow-xl shadow-black/40"
        >
          <p class="flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-slate-400">
            <span data-tt-dot class="inline-block size-2 rounded-full"></span>
            <span data-tt-notebook></span>
          </p>
          <p data-tt-title class="mt-0.5 text-sm font-medium text-slate-100 leading-snug"></p>
        </div>

        <div data-ui class="absolute top-3 right-3 z-10 flex flex-col gap-1">
          <button
            data-zoom="in"
            title="Zoom in"
            class="btn btn-sm btn-square border border-white/10 bg-[#131829]/80 text-slate-300 hover:text-white hover:bg-[#1a2138] backdrop-blur shadow-lg"
          >
            <.icon name="hero-plus" class="size-4" />
          </button>
          <button
            data-zoom="out"
            title="Zoom out"
            class="btn btn-sm btn-square border border-white/10 bg-[#131829]/80 text-slate-300 hover:text-white hover:bg-[#1a2138] backdrop-blur shadow-lg"
          >
            <.icon name="hero-minus" class="size-4" />
          </button>
          <button
            data-zoom="reset"
            title="Fit to view"
            class="btn btn-sm btn-square border border-white/10 bg-[#131829]/80 text-slate-300 hover:text-white hover:bg-[#1a2138] backdrop-blur shadow-lg"
          >
            <.icon name="hero-viewfinder-circle" class="size-4" />
          </button>
        </div>

        <button
          data-ui
          data-similarity
          aria-pressed="false"
          class="absolute bottom-3 left-3 z-10 btn btn-xs rounded-full border border-white/10 bg-[#131829]/80 text-slate-300 hover:text-white backdrop-blur gap-1.5 ring-indigo-400/50"
        >
          <span class="inline-block w-3 h-px bg-slate-500"></span> Similarity threads
        </button>
      </div>
    </div>

    <footer
      :if={!@loading && @node_count > 0}
      class="shrink-0 border-t border-white/5 bg-[#0d1120] px-6 py-2 flex flex-wrap items-center gap-x-4 gap-y-1"
    >
      <span
        :for={{name, color} <- @notebook_legend}
        class="inline-flex items-center gap-1.5 text-[11px] text-slate-400"
      >
        <span class="inline-block size-2 rounded-full" style={"background: #{color}"}></span>
        {name}
      </span>
      <span class="mx-1 h-3 w-px bg-white/10"></span>
      <span
        :for={{kind, color} <- edge_legend()}
        class="inline-flex items-center gap-1.5 text-[11px] text-slate-400"
      >
        <span class="inline-block w-4 h-0.5 rounded" style={"background: #{color}"}></span>
        {String.replace(kind, "_", " ")}
      </span>
      <span class="ml-auto text-[11px] text-slate-500">
        hover to focus a constellation · drag stars · scroll or pinch to zoom · double-click to fit
      </span>
    </footer>
  </div>
</Layouts.reader>
