<Layouts.reader flash={@flash}>
  <div class="flex flex-col h-full overflow-hidden bg-base-100">
    <header class="shrink-0 border-b border-base-300 bg-gradient-to-r from-primary/10 via-base-100 to-base-100 px-4 md:px-6 py-3 flex flex-wrap items-center gap-x-4 gap-y-2">
      <div class="flex items-center gap-2.5">
        <div class="size-9 rounded-xl bg-primary/15 text-primary grid place-items-center">
          <.icon name="hero-share" class="size-5" />
        </div>
        <div class="leading-tight">
          <h1 class="text-base font-bold tracking-tight">Knowledge Map</h1>
          <p class="text-[11px] text-base-content/50">
            {@note_count} notes · {@link_count} typed links
          </p>
        </div>
      </div>
      <.link navigate="/vault" class="press btn btn-ghost btn-xs rounded-full gap-1">
        <.icon name="hero-arrow-left" class="size-3" /> Vault
      </.link>
      <Layouts.nav_pills active={:graph} class="ml-auto" />
    </header>

    <div class="flex-1 min-h-0 relative overflow-hidden">
      <div
        :if={@loading}
        class="absolute inset-0 z-20 grid place-items-center text-base-content/40 bg-base-100"
      >
        <div class="text-center select-none">
          <span class="loading loading-ring loading-lg"></span>
          <p class="mt-2 text-sm">Building the map…</p>
        </div>
      </div>

      <div
        :if={!@loading && @note_count == 0}
        class="absolute inset-0 z-20 grid place-items-center text-base-content/40 bg-base-100"
      >
        <div class="text-center select-none max-w-sm">
          <div class="size-16 mx-auto rounded-2xl bg-base-200 grid place-items-center mb-4">
            <.icon name="hero-share" class="size-8" />
          </div>
          <p class="text-lg font-medium">Nothing to map yet</p>
          <p class="text-sm mt-1">Import or clip some notes and the vault appears here.</p>
        </div>
      </div>

      <div
        id="graph-canvas"
        phx-hook="MindMap"
        phx-update="ignore"
        class="absolute inset-0 cursor-grab select-none touch-none text-base-content"
      >
        <svg class="w-full h-full">
          <g data-viewport>
            <g data-links></g>
            <g data-overlay></g>
            <g data-nodes></g>
          </g>
        </svg>

        <div data-ui class="absolute top-3 left-3 z-10 w-72 max-w-[calc(100%-6rem)]">
          <div class="relative">
            <.icon
              name="hero-magnifying-glass"
              class="size-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-base-content/40 pointer-events-none"
            />
            <input
              data-search
              type="text"
              placeholder="Find a note, tag, or notebook…  ( / )"
              autocomplete="off"
              class="w-full rounded-full border border-base-300 bg-base-100/90 backdrop-blur pl-8 pr-8 py-1.5 text-sm placeholder:text-base-content/40 focus:outline-none focus:border-primary/50 shadow"
            />
            <button
              data-search-clear
              title="Clear search"
              class="absolute right-2 top-1/2 -translate-y-1/2 text-base-content/40 hover:text-base-content hidden"
            >
              <.icon name="hero-x-mark" class="size-3.5" />
            </button>
          </div>
          <div
            data-results
            class="mt-1 hidden rounded-xl border border-base-300 bg-base-100/95 backdrop-blur shadow-xl overflow-hidden"
          >
          </div>
        </div>

        <div data-ui class="absolute top-3 right-3 z-10 flex flex-col gap-1">
          <button
            data-zoom="in"
            title="Zoom in"
            class="btn btn-sm btn-square border border-base-300 bg-base-100/90 backdrop-blur shadow"
          >
            <.icon name="hero-plus" class="size-4" />
          </button>
          <button
            data-zoom="out"
            title="Zoom out"
            class="btn btn-sm btn-square border border-base-300 bg-base-100/90 backdrop-blur shadow"
          >
            <.icon name="hero-minus" class="size-4" />
          </button>
          <button
            data-zoom="reset"
            title="Collapse all and fit"
            class="btn btn-sm btn-square border border-base-300 bg-base-100/90 backdrop-blur shadow"
          >
            <.icon name="hero-viewfinder-circle" class="size-4" />
          </button>
        </div>
      </div>
    </div>

    <footer
      :if={!@loading && @note_count > 0}
      class="shrink-0 border-t border-base-300 bg-base-100 px-4 md:px-6 py-2 flex flex-wrap items-center gap-x-4 gap-y-1"
    >
      <span
        :for={{kind, color} <- edge_legend()}
        class="inline-flex items-center gap-1.5 text-[11px] text-base-content/60"
      >
        <span
          class="inline-block w-4 h-0.5 rounded"
          style={"background: repeating-linear-gradient(90deg, #{color} 0 4px, transparent 4px 7px)"}
        >
        </span>
        {String.replace(kind, "_", " ")}
      </span>
      <span class="ml-auto text-[11px] text-base-content/40 max-md:hidden">
        click a branch to expand · click a note to open · hover ⇄ for its links · double-click to fit
      </span>
    </footer>
  </div>
</Layouts.reader>
