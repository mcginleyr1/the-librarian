<Layouts.reader flash={@flash}>
  <div class="flex flex-col h-full overflow-hidden bg-base-200/40">
    <header class="shrink-0 border-b border-base-300 bg-gradient-to-r from-primary/10 via-base-100 to-base-100 px-6 py-3 flex items-center gap-4">
      <div class="flex items-center gap-2.5">
        <div class="size-9 rounded-xl bg-primary/15 text-primary grid place-items-center">
          <.icon name="hero-share" class="size-5" />
        </div>
        <div class="leading-tight">
          <h1 class="text-base font-bold tracking-tight">Knowledge Graph</h1>
          <p class="text-[11px] text-base-content/50">
            {@node_count} notes · {@edge_count} connections
          </p>
        </div>
      </div>
      <.link navigate="/vault" class="press btn btn-ghost btn-xs rounded-full gap-1">
        <.icon name="hero-arrow-left" class="size-3" /> Vault
      </.link>
      <Layouts.nav_pills active={:graph} class="ml-auto" />
    </header>

    <div :if={@loading} class="flex-1 grid place-items-center text-base-content/40">
      <div class="text-center select-none">
        <span class="loading loading-ring loading-lg"></span>
        <p class="mt-2 text-sm">Laying out the graph…</p>
      </div>
    </div>

    <div
      :if={!@loading && @nodes == []}
      class="flex-1 grid place-items-center text-base-content/30"
    >
      <div class="text-center select-none max-w-sm">
        <div class="size-16 mx-auto rounded-2xl bg-base-200 grid place-items-center mb-4">
          <.icon name="hero-share" class="size-8" />
        </div>
        <p class="text-lg font-medium">No connections yet</p>
        <p class="text-sm mt-1">
          Edges appear as the graph builds in the background — check the AI tab in Settings.
        </p>
      </div>
    </div>

    <div
      :if={!@loading && @nodes != []}
      id="graph-canvas"
      phx-hook=".GraphPanZoom"
      class="flex-1 min-h-0 relative cursor-grab select-none touch-none overflow-hidden"
    >
      <div class="absolute top-3 right-3 z-10 flex flex-col gap-1">
        <button
          data-zoom="in"
          title="Zoom in"
          class="btn btn-sm btn-square bg-base-100/90 shadow border border-base-300"
        >
          <.icon name="hero-plus" class="size-4" />
        </button>
        <button
          data-zoom="out"
          title="Zoom out"
          class="btn btn-sm btn-square bg-base-100/90 shadow border border-base-300"
        >
          <.icon name="hero-minus" class="size-4" />
        </button>
        <button
          data-zoom="reset"
          title="Reset view"
          class="btn btn-sm btn-square bg-base-100/90 shadow border border-base-300"
        >
          <.icon name="hero-viewfinder-circle" class="size-4" />
        </button>
      </div>
      <svg viewBox="0 0 1200 800" class="w-full h-full">
        <g data-viewport>
          <line
            :for={edge <- @edges}
            x1={edge.x1}
            y1={edge.y1}
            x2={edge.x2}
            y2={edge.y2}
            stroke={edge_color(edge.kind)}
            stroke-width={0.5 + edge.weight}
            stroke-opacity="0.45"
          />
          <g
            :for={node <- @nodes}
            transform={"translate(#{node.x} #{node.y})"}
            phx-click="open_note"
            phx-value-id={node.id}
            class="cursor-pointer"
          >
            <circle
              r={node_radius(node.degree)}
              fill={notebook_color(node.notebook_id)}
              fill-opacity="0.9"
              stroke="#ffffff"
              stroke-width="1.5"
            />
            <text
              :if={node.degree >= 3 or @node_count <= 60}
              y={node_radius(node.degree) + 10}
              text-anchor="middle"
              font-size="9"
              fill="currentColor"
              opacity="0.6"
            >
              {String.slice(node.title || "(Untitled)", 0, 28)}
            </text>
            <title>{node.title || "(Untitled)"}</title>
          </g>
        </g>
      </svg>
    </div>

    <footer
      :if={!@loading && @nodes != []}
      class="shrink-0 border-t border-base-300 bg-base-100 px-6 py-2 flex flex-wrap items-center gap-x-4 gap-y-1"
    >
      <span
        :for={{kind, color} <- edge_legend()}
        class="inline-flex items-center gap-1.5 text-[11px] text-base-content/60"
      >
        <span class="inline-block w-4 h-0.5 rounded" style={"background: #{color}"}></span>
        {String.replace(kind, "_", " ")}
      </span>
      <span class="ml-auto text-[11px] text-base-content/40">
        scroll or pinch to zoom · drag to pan · double-click to reset · click a note to open it
      </span>
    </footer>
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".GraphPanZoom">
    export default {
      mounted() {
        const svg = this.el.querySelector("svg")
        const viewport = this.el.querySelector("[data-viewport]")
        const VB_W = 1200, VB_H = 800
        let scale = 1, tx = 0, ty = 0
        const pointers = new Map()
        let moved = 0, pinchDist = null

        const apply = () =>
          viewport.setAttribute("transform", `translate(${tx} ${ty}) scale(${scale})`)

        // screen px -> svg user units (viewBox, default xMidYMid meet)
        const toUser = (clientX, clientY) => {
          const rect = svg.getBoundingClientRect()
          const s = Math.min(rect.width / VB_W, rect.height / VB_H)
          return {
            x: (clientX - rect.left - (rect.width - VB_W * s) / 2) / s,
            y: (clientY - rect.top - (rect.height - VB_H * s) / 2) / s,
            s,
          }
        }

        const zoomAt = (clientX, clientY, factor) => {
          const next = Math.min(Math.max(scale * factor, 0.15), 8)
          const u = toUser(clientX, clientY)
          tx = u.x - (next / scale) * (u.x - tx)
          ty = u.y - (next / scale) * (u.y - ty)
          scale = next
          apply()
        }

        const zoomCenter = (factor) => {
          const r = svg.getBoundingClientRect()
          zoomAt(r.left + r.width / 2, r.top + r.height / 2, factor)
        }

        const reset = () => { scale = 1; tx = 0; ty = 0; apply() }

        this.el.addEventListener("wheel", (e) => {
          e.preventDefault()
          zoomAt(e.clientX, e.clientY, e.deltaY < 0 ? 1.15 : 0.87)
        }, { passive: false })

        this.el.addEventListener("pointerdown", (e) => {
          if (e.target.closest("[data-zoom]")) return
          pointers.set(e.pointerId, { x: e.clientX, y: e.clientY })
          if (pointers.size === 1) moved = 0
          pinchDist = null
        })

        this.el.addEventListener("pointermove", (e) => {
          if (!pointers.has(e.pointerId)) return
          const prev = pointers.get(e.pointerId)
          pointers.set(e.pointerId, { x: e.clientX, y: e.clientY })

          if (pointers.size === 2) {
            const [a, b] = [...pointers.values()]
            const dist = Math.hypot(a.x - b.x, a.y - b.y)
            if (pinchDist) zoomAt((a.x + b.x) / 2, (a.y + b.y) / 2, dist / pinchDist)
            pinchDist = dist
            moved += 10
            return
          }

          const dx = e.clientX - prev.x
          const dy = e.clientY - prev.y
          moved += Math.abs(dx) + Math.abs(dy)
          if (moved > 5) {
            if (!this.el.hasPointerCapture(e.pointerId)) this.el.setPointerCapture(e.pointerId)
            this.el.classList.add("cursor-grabbing")
            const { s } = toUser(e.clientX, e.clientY)
            tx += dx / s
            ty += dy / s
            apply()
          }
        })

        const release = (e) => {
          pointers.delete(e.pointerId)
          pinchDist = null
          if (pointers.size === 0) this.el.classList.remove("cursor-grabbing")
        }
        this.el.addEventListener("pointerup", release)
        this.el.addEventListener("pointercancel", release)

        // a drag or pinch must not fire the node's phx-click
        this.el.addEventListener("click", (e) => {
          if (e.target.closest("[data-zoom]")) return
          if (moved > 5) { e.stopPropagation(); e.preventDefault() }
        }, true)

        this.el.addEventListener("dblclick", (e) => {
          if (!e.target.closest("[data-zoom]")) reset()
        })

        this.el.querySelector('[data-zoom="in"]').addEventListener("click", () => zoomCenter(1.4))
        this.el.querySelector('[data-zoom="out"]').addEventListener("click", () => zoomCenter(0.7))
        this.el.querySelector('[data-zoom="reset"]').addEventListener("click", reset)
      }
    }
  </script>
</Layouts.reader>
