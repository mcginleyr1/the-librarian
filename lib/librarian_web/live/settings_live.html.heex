<Layouts.app flash={@flash}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <%!-- Header with back nav --%>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-6">
      <a href="/reader" class="btn btn-ghost btn-sm gap-1">
        <.icon name="hero-arrow-left" class="w-4 h-4" /> Reader
      </a>
      <a href="/vault" class="btn btn-ghost btn-sm gap-1">
        <.icon name="hero-archive-box" class="w-4 h-4" /> Vault
      </a>
      <h1 class="text-2xl font-bold ml-2">Settings</h1>
      <div class="ml-auto flex items-center gap-2">
        <img
          :if={@current_user.avatar_url}
          src={@current_user.avatar_url}
          referrerpolicy="no-referrer"
          class="w-7 h-7 rounded-full"
        />
        <span class="text-sm text-base-content/60 max-sm:hidden">{@current_user.email}</span>
        <.link href={~p"/logout"} method="delete" id="sign-out" class="btn btn-ghost btn-sm gap-1">
          <.icon name="hero-arrow-right-start-on-rectangle" class="w-4 h-4" /> Sign out
        </.link>
      </div>
    </div>

    <%!-- Tabs --%>
    <div class="tabs tabs-bordered mb-6">
      <.link patch="/settings?tab=import" class={tab_class(@tab, :import)}>
        <.icon name="hero-arrow-up-tray" class="w-4 h-4 mr-1" /> Import
      </.link>
      <.link patch="/settings?tab=feeds" class={tab_class(@tab, :feeds)}>
        <.icon name="hero-rss" class="w-4 h-4 mr-1" /> Feeds
        <span class="badge badge-sm ml-1">{length(@feeds)}</span>
      </.link>
      <.link patch="/settings?tab=notebooks" class={tab_class(@tab, :notebooks)}>
        <.icon name="hero-book-open" class="w-4 h-4 mr-1" /> Notebooks
        <span class="badge badge-sm ml-1">{length(@notebooks)}</span>
      </.link>
      <.link patch="/settings?tab=backup" class={tab_class(@tab, :backup)}>
        <.icon name="hero-cloud-arrow-up" class="w-4 h-4 mr-1" /> Backup
      </.link>
      <.link patch="/settings?tab=ai" class={tab_class(@tab, :ai)}>
        <.icon name="hero-sparkles" class="w-4 h-4 mr-1" /> AI
      </.link>
    </div>

    <%!-- ── IMPORT TAB ── --%>
    <div :if={@tab == :import} class="space-y-8">
      <%!-- Result banner --%>
      <div :if={@import_result} class="alert alert-success">
        <.icon name="hero-check-circle" class="w-5 h-5" />
        <span>
          <%= case @import_result do %>
            <% {:opml, stats} -> %>
              Imported <strong>{stats.imported}</strong>
              feeds across <strong>{stats.categories}</strong>
              categories
              (<strong>{stats.skipped}</strong> duplicates skipped).
            <% {:enex, stats} -> %>
              Imported <strong>{stats.notes_count}</strong>
              notes and <strong>{stats.attachments_count}</strong>
              attachments
              (<strong>{stats.errors}</strong> errors).
          <% end %>
        </span>
        <button phx-click="clear_result" class="btn btn-sm btn-ghost ml-auto">Dismiss</button>
      </div>

      <%!-- OPML Upload --%>
      <div class="card bg-base-200">
        <div class="card-body">
          <h2 class="card-title text-lg">
            <.icon name="hero-rss" class="w-5 h-5" /> Import Feeds (OPML)
          </h2>
          <p class="text-sm text-base-content/60">
            Upload an OPML file from Feedly, Inoreader, or any RSS reader. Existing feeds are preserved.
          </p>
          <form phx-submit="import_opml" phx-change="validate_opml" class="mt-4 space-y-3">
            <div
              class="border-2 border-dashed border-base-300 rounded-lg p-6 text-center"
              phx-drop-target={@uploads.opml.ref}
            >
              <.live_file_input upload={@uploads.opml} class="hidden" />
              <.icon
                name="hero-document-arrow-up"
                class="w-10 h-10 mx-auto text-base-content/30 mb-2"
              />
              <%= if @uploads.opml.entries == [] do %>
                <p class="text-base-content/50">
                  Drop an OPML file here or
                  <label class="link link-primary cursor-pointer" for={@uploads.opml.ref}>
                    browse
                  </label>
                </p>
              <% else %>
                <div
                  :for={entry <- @uploads.opml.entries}
                  class="flex items-center justify-center gap-2"
                >
                  <.icon name="hero-document" class="w-5 h-5 text-primary" />
                  <span class="font-medium">{entry.client_name}</span>
                  <span class="text-base-content/50 text-sm">
                    ({Float.round(entry.client_size / 1024, 1)} KB)
                  </span>
                  <button
                    type="button"
                    phx-click="cancel_opml"
                    phx-value-ref={entry.ref}
                    class="btn btn-xs btn-ghost text-error"
                  >
                    &#x2715;
                  </button>
                </div>
              <% end %>
            </div>
            <div class="flex justify-end">
              <button
                type="submit"
                class="btn btn-primary gap-2"
                disabled={@uploads.opml.entries == []}
              >
                <.icon name="hero-arrow-up-tray" class="w-4 h-4" /> Import Feeds
              </button>
            </div>
          </form>
        </div>
      </div>

      <%!-- ENEX Upload --%>
      <div class="card bg-base-200">
        <div class="card-body">
          <h2 class="card-title text-lg">
            <.icon name="hero-document-text" class="w-5 h-5" /> Import Notes (Evernote ENEX)
          </h2>
          <p class="text-sm text-base-content/60">
            Export from Evernote: File &rarr; Export All Notes &rarr; ENEX format. Notes are imported into a notebook.
          </p>
          <form phx-submit="import_enex" phx-change="validate_enex" class="mt-4 space-y-3">
            <div>
              <label class="label">
                <span class="label-text font-medium">Notebook name</span>
                <span class="label-text-alt text-base-content/40">defaults to filename</span>
              </label>
              <input
                type="text"
                name="notebook"
                value={@enex_notebook}
                placeholder="e.g. Research, Personal, Work"
                class="input input-bordered w-full"
              />
            </div>
            <div
              class="border-2 border-dashed border-base-300 rounded-lg p-6 text-center"
              phx-drop-target={@uploads.enex.ref}
            >
              <.live_file_input upload={@uploads.enex} class="hidden" />
              <.icon
                name="hero-document-arrow-up"
                class="w-10 h-10 mx-auto text-base-content/30 mb-2"
              />
              <%= if @uploads.enex.entries == [] do %>
                <p class="text-base-content/50">
                  Drop an ENEX file here or
                  <label class="link link-primary cursor-pointer" for={@uploads.enex.ref}>
                    browse
                  </label>
                </p>
                <p class="text-xs text-base-content/30 mt-1">
                  Large exports (100MB+) are supported
                </p>
              <% else %>
                <div
                  :for={entry <- @uploads.enex.entries}
                  class="flex items-center justify-center gap-2"
                >
                  <.icon name="hero-document" class="w-5 h-5 text-primary" />
                  <span class="font-medium">{entry.client_name}</span>
                  <span class="text-base-content/50 text-sm">
                    ({Float.round(entry.client_size / 1_048_576, 1)} MB)
                  </span>
                  <button
                    type="button"
                    phx-click="cancel_enex"
                    phx-value-ref={entry.ref}
                    class="btn btn-xs btn-ghost text-error"
                  >
                    &#x2715;
                  </button>
                </div>
              <% end %>
            </div>
            <div class="flex items-center justify-end gap-3">
              <span
                :if={@importing_enex}
                class="text-sm text-base-content/60 flex items-center gap-2"
              >
                <span class="loading loading-spinner loading-sm"></span>
                Importing... this may take a while for large exports
              </span>
              <button
                type="submit"
                class="btn btn-primary gap-2"
                disabled={@uploads.enex.entries == [] || @importing_enex}
              >
                <.icon name="hero-arrow-up-tray" class="w-4 h-4" /> Import Notes
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <%!-- ── FEEDS TAB ── --%>
    <div :if={@tab == :feeds} class="space-y-6">
      <%!-- Feed Discovery --%>
      <div class="card bg-base-200">
        <div class="card-body pb-4">
          <h2 class="card-title text-base mb-1">Find a Feed</h2>
          <p class="text-sm text-base-content/50 mb-3">
            Enter any website URL and we'll find its RSS/Atom feed.
          </p>
          <form phx-submit="discover_feed" class="flex gap-2">
            <input
              type="text"
              name="url"
              placeholder="https://io9.com"
              class="input input-bordered input-sm flex-1"
              disabled={@discovering}
            />
            <button type="submit" class="btn btn-primary btn-sm gap-1" disabled={@discovering}>
              <%= if @discovering do %>
                <span class="loading loading-spinner loading-xs"></span> Searching…
              <% else %>
                <.icon name="hero-magnifying-glass" class="w-4 h-4" /> Find Feed
              <% end %>
            </button>
          </form>

          <%!-- Error --%>
          <div :if={@discover_error} class="alert alert-warning mt-3 py-2 text-sm">
            <.icon name="hero-exclamation-triangle" class="w-4 h-4" />
            {@discover_error}
            <button phx-click="clear_discovery" class="btn btn-xs btn-ghost ml-auto">
              Dismiss
            </button>
          </div>

          <%!-- Results --%>
          <div :if={@discovered_feeds} class="mt-3 space-y-2">
            <div class="flex items-center justify-between">
              <p class="text-sm font-medium">
                {length(@discovered_feeds)} feed{if length(@discovered_feeds) != 1, do: "s"} found
              </p>
              <button phx-click="clear_discovery" class="btn btn-xs btn-ghost">Clear</button>
            </div>
            <%= for feed <- @discovered_feeds do %>
              <form
                phx-submit="add_discovered"
                class="flex gap-2 items-center bg-base-100 rounded-lg px-3 py-2 flex-wrap"
              >
                <input type="hidden" name="feed_url" value={feed.url} />
                <div class="flex-1 min-w-0">
                  <input
                    type="text"
                    name="title"
                    value={feed.title}
                    class="input input-bordered input-xs w-full font-medium"
                    required
                  />
                  <p class="text-xs text-base-content/40 mt-0.5 truncate">{feed.url}</p>
                </div>
                <input
                  type="text"
                  name="category"
                  placeholder="Category"
                  list="categories-list"
                  class="input input-bordered input-xs w-32"
                />
                <button type="submit" class="btn btn-primary btn-xs gap-1">
                  <.icon name="hero-plus" class="w-3 h-3" /> Add
                </button>
              </form>
            <% end %>
          </div>
        </div>
      </div>

      <%!-- Add new feed (direct URL) --%>
      <div class="card bg-base-200">
        <div class="card-body pb-4">
          <h2 class="card-title text-base mb-3">Add Feed</h2>
          <form phx-submit="add_feed" class="flex gap-2 flex-wrap">
            <input
              type="text"
              name="title"
              placeholder="Feed name"
              class="input input-bordered input-sm flex-1 min-w-32"
              required
            />
            <input
              type="url"
              name="feed_url"
              placeholder="https://example.com/feed.xml"
              class="input input-bordered input-sm flex-1 min-w-64"
              required
            />
            <input
              type="text"
              name="category"
              placeholder="Category"
              list="categories-list"
              class="input input-bordered input-sm w-36"
            />
            <datalist id="categories-list">
              <option :for={cat <- @categories} value={cat}>{cat}</option>
            </datalist>
            <button type="submit" class="btn btn-primary btn-sm gap-1">
              <.icon name="hero-plus" class="w-4 h-4" /> Add
            </button>
          </form>
        </div>
      </div>

      <%!-- Category order & For You lenses --%>
      <div :if={@category_order != []} class="card bg-base-200">
        <div class="card-body pb-4">
          <h2 class="card-title text-base mb-1">Categories</h2>
          <p class="text-sm text-base-content/50 mb-3">
            Order controls the reader sidebar, top to bottom. The bolt pins a category as a For You lens.
          </p>
          <div class="space-y-1">
            <div
              :for={{cat, i} <- Enum.with_index(@category_order)}
              id={"category-row-#{String.replace(cat, ~r/\W+/, "-")}"}
              class="flex items-center gap-1 bg-base-100 rounded-lg px-3 py-1.5"
            >
              <span class="flex-1 text-sm font-medium truncate">{cat}</span>
              <button
                phx-click="toggle_lens"
                phx-value-category={cat}
                class={[
                  "btn btn-ghost btn-xs",
                  if(cat in @pinned_lenses, do: "text-primary", else: "text-base-content/30")
                ]}
                title={
                  if(cat in @pinned_lenses,
                    do: "Remove For You lens",
                    else: "Pin as For You lens"
                  )
                }
              >
                <.icon name="hero-bolt" class="w-3.5 h-3.5" />
              </button>
              <%= if active_in_category(@feeds, cat) > 0 do %>
                <button
                  id={"deactivate-category-#{String.replace(cat, ~r/\W+/, "-")}"}
                  phx-click="set_category_active"
                  phx-value-category={cat}
                  phx-value-active="false"
                  data-confirm={"Deactivate all #{active_in_category(@feeds, cat)} feeds in #{cat}? They stop fetching and drop out of Reader and For You, but keep their articles and history."}
                  class="btn btn-ghost btn-xs text-base-content/30"
                  title="Deactivate all feeds in this category"
                >
                  <.icon name="hero-pause" class="w-3.5 h-3.5" />
                </button>
              <% else %>
                <button
                  id={"activate-category-#{String.replace(cat, ~r/\W+/, "-")}"}
                  phx-click="set_category_active"
                  phx-value-category={cat}
                  phx-value-active="true"
                  class="btn btn-ghost btn-xs text-success"
                  title="Reactivate all feeds in this category"
                >
                  <.icon name="hero-play" class="w-3.5 h-3.5" />
                </button>
              <% end %>
              <button
                phx-click="move_category"
                phx-value-category={cat}
                phx-value-dir="up"
                disabled={i == 0}
                class="btn btn-ghost btn-xs disabled:opacity-20"
                title="Move up"
              >
                <.icon name="hero-chevron-up" class="w-3.5 h-3.5" />
              </button>
              <button
                phx-click="move_category"
                phx-value-category={cat}
                phx-value-dir="down"
                disabled={i == length(@category_order) - 1}
                class="btn btn-ghost btn-xs disabled:opacity-20"
                title="Move down"
              >
                <.icon name="hero-chevron-down" class="w-3.5 h-3.5" />
              </button>
            </div>
          </div>
        </div>
      </div>

      <%!-- Fetch all --%>
      <div class="flex justify-end">
        <button phx-click="fetch_all_feeds" class="btn btn-sm btn-outline gap-2">
          <.icon name="hero-arrow-path" class="w-4 h-4" /> Fetch All Now
        </button>
      </div>

      <%!-- Feeds table --%>
      <div class="overflow-x-auto">
        <table class="table table-sm w-full">
          <thead>
            <tr class="text-base-content/50">
              <th>Feed</th>
              <th>Category</th>
              <th class="w-20 text-center">Active</th>
              <th class="w-24"></th>
            </tr>
          </thead>
          <tbody>
            <tr :for={feed <- @feeds} class="hover">
              <td :if={@editing_feed_id != feed.id} colspan="4">
                <div class="flex items-start justify-between gap-2">
                  <div class="min-w-0">
                    <p class={"font-medium truncate #{unless feed.active, do: "line-through text-base-content/40"}"}>
                      {feed.title}
                    </p>
                    <p class="text-xs text-base-content/40 truncate">{feed.feed_url}</p>
                    <p :if={feed.fetch_error} class="text-xs text-error mt-0.5">
                      &#x26A0; {feed.fetch_error}
                    </p>
                  </div>
                  <div class="flex items-center gap-1 shrink-0">
                    <span
                      :if={feed.fetch_interval_minutes != 120}
                      class="badge badge-primary badge-outline badge-sm"
                      title="Fetch interval"
                    >
                      {feed.fetch_interval_minutes}m
                    </span>
                    <span class="badge badge-ghost badge-sm">{feed.category || "—"}</span>
                    <button
                      phx-click="fetch_feed"
                      phx-value-id={feed.id}
                      class="btn btn-ghost btn-xs"
                      title="Fetch now"
                    >
                      <.icon name="hero-arrow-path" class="w-3 h-3" />
                    </button>
                    <button
                      phx-click="edit_feed"
                      phx-value-id={feed.id}
                      class="btn btn-ghost btn-xs"
                    >
                      <.icon name="hero-pencil" class="w-3 h-3" />
                    </button>
                    <input
                      type="checkbox"
                      class="toggle toggle-xs toggle-primary"
                      checked={feed.active}
                      phx-click="toggle_feed_active"
                      phx-value-id={feed.id}
                    />
                    <button
                      phx-click="delete_feed"
                      phx-value-id={feed.id}
                      data-confirm={"Delete #{feed.title}? This removes all its articles."}
                      class="btn btn-ghost btn-xs text-error"
                    >
                      <.icon name="hero-trash" class="w-3 h-3" />
                    </button>
                  </div>
                </div>
              </td>

              <%!-- Inline edit row --%>
              <td :if={@editing_feed_id == feed.id} colspan="4">
                <.form
                  for={@feed_form}
                  phx-submit="save_feed"
                  class="flex gap-2 flex-wrap items-end py-1"
                >
                  <div class="flex-1 min-w-48">
                    <label class="label py-0">
                      <span class="label-text text-xs">Title</span>
                    </label>
                    <.input
                      field={@feed_form[:title]}
                      type="text"
                      class="input input-bordered input-sm w-full"
                    />
                  </div>
                  <div class="flex-[2] min-w-64">
                    <label class="label py-0">
                      <span class="label-text text-xs">Feed URL</span>
                    </label>
                    <.input
                      field={@feed_form[:feed_url]}
                      type="url"
                      class="input input-bordered input-sm w-full"
                    />
                  </div>
                  <div class="w-40">
                    <label class="label py-0">
                      <span class="label-text text-xs">Category</span>
                    </label>
                    <input
                      type="text"
                      name="feed[category]"
                      value={Phoenix.HTML.Form.input_value(@feed_form, :category)}
                      list="categories-list"
                      class="input input-bordered input-sm w-full"
                      placeholder="Category"
                    />
                  </div>
                  <div class="w-32">
                    <label class="label py-0">
                      <span class="label-text text-xs">Fetch every (min)</span>
                    </label>
                    <input
                      type="number"
                      name="feed[fetch_interval_minutes]"
                      value={Phoenix.HTML.Form.input_value(@feed_form, :fetch_interval_minutes)}
                      min="5"
                      step="5"
                      class="input input-bordered input-sm w-full"
                    />
                  </div>
                  <div class="flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm">Save</button>
                    <button
                      type="button"
                      phx-click="cancel_edit_feed"
                      class="btn btn-ghost btn-sm"
                    >
                      Cancel
                    </button>
                  </div>
                </.form>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <%!-- ── NOTEBOOKS TAB ── --%>
    <div :if={@tab == :notebooks} class="space-y-4">
      <p class="text-sm text-base-content/50">
        Notes whose notebook is deleted will be unassigned (not deleted).
      </p>
      <div :if={@duplicate_count > 0} class="alert alert-warning">
        <.icon name="hero-document-duplicate" class="w-5 h-5" />
        <span>
          {@duplicate_count} duplicate {if @duplicate_count == 1, do: "note", else: "notes"} found
          (same notebook, title, and content — usually from re-running an Evernote import).
          Removing keeps the oldest copy and moves its annotations over.
        </span>
        <button
          phx-click="dedupe_notes"
          data-confirm="Remove duplicate notes? The oldest copy of each is kept."
          class="btn btn-sm btn-warning"
        >
          Remove duplicates
        </button>
      </div>
      <div class="overflow-x-auto">
        <table class="table table-sm w-full">
          <thead>
            <tr class="text-base-content/50">
              <th>Notebook</th>
              <th class="w-24 text-right">Notes</th>
              <th class="w-24"></th>
            </tr>
          </thead>
          <tbody>
            <tr :for={nb <- @notebooks} class="hover">
              <td :if={@editing_notebook_id != nb.id}>
                <span class="font-medium">{nb.name}</span>
              </td>
              <td :if={@editing_notebook_id == nb.id}>
                <form phx-submit="save_notebook" class="flex gap-2">
                  <input type="hidden" name="notebook_id" value={nb.id} />
                  <input
                    type="text"
                    name="name"
                    value={nb.name}
                    class="input input-bordered input-sm flex-1"
                    required
                    autofocus
                  />
                  <button type="submit" class="btn btn-primary btn-sm">Save</button>
                  <button
                    type="button"
                    phx-click="cancel_edit_notebook"
                    class="btn btn-ghost btn-sm"
                  >
                    Cancel
                  </button>
                </form>
              </td>
              <td :if={@editing_notebook_id != nb.id} class="text-right text-base-content/50">
                {Map.get(@note_counts, nb.id, 0)}
              </td>
              <td :if={@editing_notebook_id == nb.id}></td>
              <td :if={@editing_notebook_id != nb.id} class="text-right">
                <div class="flex gap-1 justify-end">
                  <button
                    phx-click="edit_notebook"
                    phx-value-id={nb.id}
                    class="btn btn-ghost btn-xs"
                  >
                    <.icon name="hero-pencil" class="w-3 h-3" />
                  </button>
                  <button
                    phx-click="delete_notebook"
                    phx-value-id={nb.id}
                    data-confirm={"Delete notebook #{nb.name}? Notes will be unassigned."}
                    class="btn btn-ghost btn-xs text-error"
                  >
                    <.icon name="hero-trash" class="w-3 h-3" />
                  </button>
                </div>
              </td>
              <td :if={@editing_notebook_id == nb.id}></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <%!-- ── BACKUP TAB ── --%>
    <div :if={@tab == :backup} class="space-y-6">
      <div class="card bg-base-200">
        <div class="card-body">
          <h2 class="card-title text-lg">
            <.icon name="hero-cloud-arrow-up" class="w-5 h-5" /> Backblaze B2 Credentials
          </h2>
          <p class="text-sm text-base-content/60">
            Notes are backed up daily as Markdown files to your B2 bucket. Only missing files are uploaded — existing backups are never overwritten.
          </p>
          <.form
            for={@backup_form}
            id="backup-settings-form"
            phx-submit="save_backup"
            class="mt-4 space-y-4"
          >
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label class="label">
                  <span class="label-text font-medium">Key ID</span>
                </label>
                <div class="font-mono text-sm">
                  <.input
                    field={@backup_form[:b2_key_id]}
                    type="text"
                    placeholder="0014a7b2c3d4e5f6..."
                  />
                </div>
              </div>
              <div>
                <label class="label">
                  <span class="label-text font-medium">Application Key</span>
                </label>
                <div class="font-mono text-sm">
                  <.input
                    field={@backup_form[:b2_application_key]}
                    type="password"
                    placeholder="K004..."
                  />
                </div>
              </div>
              <div>
                <label class="label">
                  <span class="label-text font-medium">Bucket Name</span>
                </label>
                <.input
                  field={@backup_form[:b2_bucket_name]}
                  type="text"
                  placeholder="my-librarian-backup"
                />
              </div>
              <div>
                <label class="label">
                  <span class="label-text font-medium">B2 Endpoint</span>
                  <span class="label-text-alt text-base-content/40">host only, no https://</span>
                </label>
                <div class="font-mono text-sm">
                  <.input
                    field={@backup_form[:b2_endpoint]}
                    type="text"
                    placeholder="s3.us-west-004.backblazeb2.com"
                  />
                </div>
              </div>
            </div>
            <div class="flex justify-end">
              <button type="submit" class="btn btn-primary gap-2">
                <.icon name="hero-check" class="w-4 h-4" /> Save Credentials
              </button>
            </div>
          </.form>
        </div>
      </div>

      <div class="card bg-base-200">
        <div class="card-body">
          <h2 class="card-title text-base">Manual Backup</h2>
          <p class="text-sm text-base-content/60">
            Backups run automatically at 2am daily. You can also trigger one now.
          </p>
          <div class="mt-3">
            <button phx-click="run_backup" class="btn btn-outline gap-2">
              <.icon name="hero-cloud-arrow-up" class="w-4 h-4" /> Back Up Now
            </button>
          </div>
        </div>
      </div>
    </div>

    <%!-- ── AI TAB ── --%>
    <div :if={@tab == :ai} class="space-y-6">
      <div class="card bg-base-200">
        <div class="card-body">
          <h2 class="card-title text-lg">
            <.icon name="hero-sparkles" class="w-5 h-5" /> Anthropic API
          </h2>
          <p class="text-sm text-base-content/60">
            Powers knowledge-graph connections between vault notes. The key is stored in the
            database, and API calls stop for the month once the budget is reached.
          </p>
          <form id="ai-settings-form" phx-submit="save_ai" class="mt-4 space-y-4">
            <div>
              <label class="label">
                <span class="label-text font-medium">API Key</span>
                <span :if={@ai_key_hint} class="label-text-alt text-success">{@ai_key_hint}</span>
              </label>
              <div class="flex gap-2">
                <div class="font-mono text-sm flex-1">
                  <input
                    type="password"
                    name="anthropic_api_key"
                    placeholder={
                      if @ai_key_hint, do: "leave blank to keep current key", else: "sk-ant-..."
                    }
                    autocomplete="off"
                    class="input input-bordered w-full"
                  />
                </div>
                <button
                  :if={@ai_key_hint}
                  type="button"
                  phx-click="clear_api_key"
                  data-confirm="Remove the stored API key?"
                  class="btn btn-ghost"
                >
                  Remove
                </button>
              </div>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label class="label">
                  <span class="label-text font-medium">Monthly budget (USD)</span>
                </label>
                <input
                  type="number"
                  name="budget_dollars"
                  value={@ai_budget_dollars}
                  min="0"
                  step="0.01"
                  class="input input-bordered w-full"
                />
              </div>
              <div>
                <label class="label">
                  <span class="label-text font-medium">Spent this month</span>
                </label>
                <div class="input input-bordered w-full flex items-center tabular-nums bg-base-100/50">
                  ${:erlang.float_to_binary(@llm_spend_cents / 100, decimals: 2)}
                </div>
              </div>
            </div>
            <div class="flex justify-end">
              <button type="submit" class="btn btn-primary gap-2">
                <.icon name="hero-check" class="w-4 h-4" /> Save
              </button>
            </div>
          </form>
        </div>
      </div>

      <div class="card bg-base-200">
        <div class="card-body">
          <h2 class="card-title text-base">Knowledge Graph</h2>
          <p class="text-sm text-base-content/60">
            Similarity edges rebuild and a batch of notes gets typed by Claude every hour.
            You can also kick off a pass now.
          </p>
          <div class="mt-3">
            <button phx-click="build_graph_now" class="btn btn-outline gap-2">
              <.icon name="hero-share" class="w-4 h-4" /> Build Graph Now
            </button>
          </div>
        </div>
      </div>

      <%!-- API access (web clipper) --%>
      <div class="card bg-base-200">
        <div class="card-body">
          <h2 class="card-title text-lg">
            <.icon name="hero-key" class="w-5 h-5" /> API Access
          </h2>
          <p class="text-sm text-base-content/60">
            The clip API requires a bearer token. Paste it into the web clipper's settings;
            regenerating invalidates the old one immediately.
          </p>
          <div class="mt-3 flex items-center gap-2 flex-wrap">
            <%= if @api_token do %>
              <code id="api-token-value" class="text-xs bg-base-100 rounded px-2 py-1 break-all">
                {@api_token}
              </code>
              <button
                id="regenerate-api-token"
                phx-click="regenerate_api_token"
                data-confirm="Regenerate the token? The clipper stops working until you paste the new one."
                class="btn btn-outline btn-sm"
              >
                Regenerate
              </button>
            <% else %>
              <button
                id="reveal-api-token"
                phx-click="reveal_api_token"
                class="btn btn-outline btn-sm"
              >
                Show token
              </button>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
