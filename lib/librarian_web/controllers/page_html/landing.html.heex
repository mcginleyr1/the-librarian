<div id="landing" class="min-h-dvh bg-base-100 text-base-content">
  <Layouts.flash_group flash={@flash} />

  <%!-- Nav --%>
  <header class="sticky top-0 z-20 border-b border-base-300/60 bg-base-100/80 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
        <span class="text-2xl">📚</span> The Librarian
      </a>
      <nav class="flex items-center gap-1 sm:gap-4">
        <a href="#features" class="btn btn-ghost btn-sm max-sm:hidden">Features</a>
        <a href="#pricing" class="btn btn-ghost btn-sm max-sm:hidden">Pricing</a>
        <a href={~p"/login"} id="nav-sign-in" class="btn btn-primary btn-sm">Sign in</a>
      </nav>
    </div>
  </header>

  <%!-- Hero --%>
  <section id="landing-hero" class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-primary/10 via-transparent to-transparent" />
    <div class="relative mx-auto max-w-3xl px-4 pb-20 pt-24 text-center sm:px-6">
      <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-base-300 bg-base-200/60 px-3 py-1 text-xs text-base-content/60">
        <.icon name="hero-sparkles" class="size-3.5 text-primary" />
        One tool instead of two subscriptions
      </p>
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        Every feed you follow.<br />Every note you keep.
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-base-content/60">
        The Librarian is a reader and a knowledge vault in one place — it pulls in
        your feeds, clips the web, learns what you care about, and connects it all
        into a knowledge graph.
      </p>
      <div class="mt-8 flex flex-col items-center gap-3">
        <a
          href={~p"/login"}
          id="cta-hero"
          class="btn btn-primary btn-lg shadow-lg transition-transform hover:-translate-y-0.5"
        >
          <%= if @trial_days > 0 do %>
            Start your {@trial_days}-day free trial
          <% else %>
            Get started
          <% end %>
          <span aria-hidden="true">→</span>
        </a>
        <p class="text-xs text-base-content/50">
          <span :if={@trial_days > 0}>Then </span>${@monthly_price}/month or ${@yearly_price}/year · cancel anytime
        </p>
      </div>
    </div>
  </section>

  <%!-- Features --%>
  <section id="features" class="border-t border-base-300/60 bg-base-200/40 py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-center text-3xl font-bold tracking-tight">
        Two jobs. One librarian.
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-center text-base-content/60">
        Stop paying separately for a feed reader and a note app that don't talk to
        each other.
      </p>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-base-300 bg-base-100 p-6 shadow-sm transition-shadow hover:shadow-md">
          <.icon name="hero-rss" class="size-7 text-primary" />
          <h3 class="mt-4 font-semibold">A reader built for volume</h3>
          <p class="mt-2 text-sm text-base-content/60">
            Unlimited RSS and Atom feeds, organized by category, with keyboard
            navigation, read and star tracking, and per-feed fetch tuning.
          </p>
        </div>

        <div class="rounded-2xl border border-base-300 bg-base-100 p-6 shadow-sm transition-shadow hover:shadow-md">
          <.icon name="hero-sparkles" class="size-7 text-primary" />
          <h3 class="mt-4 font-semibold">A stream that learns you</h3>
          <p class="mt-2 text-sm text-base-content/60">
            “For You” ranks everything against what you've read, saved, and clipped
            — and quietly discovers new sources worth following. AI included, no
            API key needed.
          </p>
        </div>

        <div class="rounded-2xl border border-base-300 bg-base-100 p-6 shadow-sm transition-shadow hover:shadow-md">
          <.icon name="hero-archive-box" class="size-7 text-primary" />
          <h3 class="mt-4 font-semibold">A vault for what matters</h3>
          <p class="mt-2 text-sm text-base-content/60">
            Notes, notebooks, and tags with full-text search. Clip from any browser
            in five modes — selection, article, page, screenshot, or PDF.
          </p>
        </div>

        <div class="rounded-2xl border border-base-300 bg-base-100 p-6 shadow-sm transition-shadow hover:shadow-md">
          <.icon name="hero-share" class="size-7 text-primary" />
          <h3 class="mt-4 font-semibold">A map of your knowledge</h3>
          <p class="mt-2 text-sm text-base-content/60">
            The knowledge graph links related notes and clips automatically, so
            ideas resurface when they're relevant instead of rotting in folders.
          </p>
        </div>

        <div class="rounded-2xl border border-base-300 bg-base-100 p-6 shadow-sm transition-shadow hover:shadow-md">
          <.icon name="hero-magnifying-glass" class="size-7 text-primary" />
          <h3 class="mt-4 font-semibold">Search across everything</h3>
          <p class="mt-2 text-sm text-base-content/60">
            One search box over every article you've fetched and every note you've
            written. Find it whether you starred it or forgot it.
          </p>
        </div>

        <div class="rounded-2xl border border-base-300 bg-base-100 p-6 shadow-sm transition-shadow hover:shadow-md">
          <.icon name="hero-arrow-up-tray" class="size-7 text-primary" />
          <h3 class="mt-4 font-semibold">Leave without losing anything</h3>
          <p class="mt-2 text-sm text-base-content/60">
            Import your Evernote notebooks (ENEX) and Feedly subscriptions (OPML)
            in minutes. Daily off-site backups keep your vault yours.
          </p>
        </div>
      </div>
    </div>
  </section>

  <%!-- Pricing --%>
  <section id="pricing" class="py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <h2 class="text-center text-3xl font-bold tracking-tight">
        Less than either tool it replaces
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-center text-base-content/60">
        Feedly Pro+ is $12.99/month. Evernote starts at $14.99/month. Running both
        costs about $28/month — The Librarian does both jobs for less than one.
      </p>

      <div class="mx-auto mt-12 max-w-md">
        <div class="rounded-3xl border-2 border-primary/50 bg-base-100 p-8 shadow-xl">
          <div class="flex items-baseline justify-center gap-2">
            <span class="text-5xl font-bold tabular-nums">${@monthly_price}</span>
            <span class="text-base-content/50">/month</span>
          </div>
          <p class="mt-1 text-center text-sm text-base-content/50">
            or ${@yearly_price}/year — 2 months free
          </p>

          <ul class="mt-8 space-y-3 text-sm">
            <li class="flex gap-3">
              <.icon name="hero-check-circle" class="size-5 shrink-0 text-success" />
              Unlimited feeds, notes, and notebooks
            </li>
            <li class="flex gap-3">
              <.icon name="hero-check-circle" class="size-5 shrink-0 text-success" />
              Web clipper for Safari, Chrome, and Orion
            </li>
            <li class="flex gap-3">
              <.icon name="hero-check-circle" class="size-5 shrink-0 text-success" />
              AI-personalized stream and source discovery — included
            </li>
            <li class="flex gap-3">
              <.icon name="hero-check-circle" class="size-5 shrink-0 text-success" />
              Knowledge graph and full-text search
            </li>
            <li class="flex gap-3">
              <.icon name="hero-check-circle" class="size-5 shrink-0 text-success" />
              Evernote and OPML import, daily backups
            </li>
          </ul>

          <a href={~p"/login"} id="cta-pricing" class="btn btn-primary btn-block btn-lg mt-8">
            <%= if @trial_days > 0 do %>
              Try it free for {@trial_days} days
            <% else %>
              Get started
            <% end %>
          </a>
          <p :if={@trial_days > 0} class="mt-3 text-center text-xs text-base-content/40">
            No charge until the trial ends. Cancel in one click.
          </p>
        </div>
      </div>
    </div>
  </section>

  <%!-- Footer --%>
  <footer class="border-t border-base-300/60 py-10">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-2 px-4 text-sm text-base-content/50 sm:px-6">
      <span class="flex items-center gap-2"><span class="text-lg">📚</span> The Librarian</span>
      <a href={~p"/login"} class="link">Sign in</a>
    </div>
  </footer>
</div>
