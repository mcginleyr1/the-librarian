# Copy to .env (gitignored) and fill in. `just` loads it into every recipe;
# anything already exported in your shell wins.

# Who may sign in: comma-separated Google accounts. Used by `just dev`,
# `just up` and `just k-apply`.
ALLOWED_EMAILS=you@example.com

# Only for `just up` (local docker stack). Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# ── Kubernetes deploy (just docker-push / deploy / k-apply) ──────────────────
# Registry you build and tag images for (e.g. a Tailscale-exposed registry).
LIBRARIAN_REGISTRY=registry.<tailnet>.ts.net:5000
# Public hostname of the app (becomes PHX_HOST in the cluster).
LIBRARIAN_HOST=librarian.<tailnet>.ts.net
# kubectl context for the cluster; leave empty to use the current context.
LIBRARIAN_KUBE_CONTEXT=

# Optional: Google OAuth client for sign-in. `just dev` reads these; the
# k-create-secrets / k-set-google-oauth recipes prompt for them when unset.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
